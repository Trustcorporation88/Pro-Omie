# Pro Omie - variáveis de ambiente (copie para .env.local no desenvolvimento)

# Banco (Supabase). O app usa o pooler em modo transação (porta 6543) via adapter-pg.
# Usuário dedicado "prisma.<ref-do-projeto>"; tabelas no schema "erp".
DATABASE_URL="postgresql://prisma.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Migrations (prisma migrate deploy) usam o pooler em modo sessão (porta 5432).
DIRECT_URL="postgresql://prisma.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?schema=erp&sslmode=require"

# Segredo da sessão (JWT). Mínimo de 32 caracteres aleatórios.
AUTH_SECRET=""

# Token de uso único da configuração inicial: abra /setup?token=<SETUP_TOKEN> para criar a empresa e o administrador.
SETUP_TOKEN=""

# Opcional
# DATABASE_SCHEMA="erp"
# DATABASE_POOL_MAX="8"
