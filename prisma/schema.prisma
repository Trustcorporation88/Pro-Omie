// Pro Omie - schema do banco (Fases 0 e 1: fundação e financeiro; multiempresa com cadastros por empresa)
// Todas as tabelas ficam no schema "erp" do Postgres (fora da Data API do Supabase).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Papel {
  ADMIN
  FINANCEIRO
  VENDAS
  ESTOQUE
  CONTADOR
}

enum RegimeTributario {
  MEI
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

enum TipoPessoa {
  FISICA
  JURIDICA
  ESTRANGEIRA
}

enum IndicadorIE {
  CONTRIBUINTE
  ISENTO
  NAO_CONTRIBUINTE
}

enum TipoProduto {
  PRODUTO
  SERVICO
}

enum TipoCategoria {
  RECEITA
  DESPESA
}

enum GrupoDRE {
  RECEITA_BRUTA
  DEDUCOES
  CUSTOS
  DESPESAS_PESSOAL
  DESPESAS_ADMINISTRATIVAS
  DESPESAS_COMERCIAIS
  RECEITAS_FINANCEIRAS
  DESPESAS_FINANCEIRAS
  OUTRAS_RECEITAS
  OUTRAS_DESPESAS
  IMPOSTOS_LUCRO
  NAO_OPERACIONAL
}

enum TipoConta {
  CORRENTE
  POUPANCA
  CAIXA
  CARTAO_CREDITO
  INVESTIMENTO
  CONTA_PAGAMENTO
}

enum MeioPagamento {
  DINHEIRO
  PIX
  BOLETO
  CARTAO_CREDITO
  CARTAO_DEBITO
  TRANSFERENCIA
  CHEQUE
  DEBITO_AUTOMATICO
  OUTRO
}

enum TipoTitulo {
  RECEBER
  PAGAR
}

enum StatusTitulo {
  ABERTO
  PARCIAL
  QUITADO
  CANCELADO
}

enum OrigemTitulo {
  MANUAL
  RECORRENCIA
  CONCILIACAO
  VENDA
  COMPRA
  CONTRATO
  NOTA_FISCAL
}

enum TipoMovimento {
  CREDITO
  DEBITO
}

enum OrigemMovimento {
  BAIXA
  TRANSFERENCIA
  AJUSTE
}

enum StatusExtratoItem {
  PENDENTE
  CONCILIADO
  IGNORADO
}

// ───────────────────────── Empresa e acesso ─────────────────────────

model Empresa {
  id                 String           @id @default(cuid())
  razaoSocial        String
  nomeFantasia       String?
  cnpj               String           @unique
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  regimeTributario   RegimeTributario @default(SIMPLES_NACIONAL)
  cnae               String?
  email              String?
  telefone           String?
  cep                String?
  logradouro         String?
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String?
  uf                 String?
  codigoMunicipio    String?
  matrizId           String?
  matriz             Empresa?         @relation("Filiais", fields: [matrizId], references: [id])
  filiais            Empresa[]        @relation("Filiais")
  ativo              Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  contasBancarias ContaBancaria[]
  titulos         Titulo[]
  pessoas         Pessoa[]
  produtos        Produto[]
  categorias      Categoria[]
  centrosCusto    CentroCusto[]
  formasPagamento FormaPagamento[]
  condicoes       CondicaoPagamento[]
  regras          RegraConciliacao[]

  propostas Proposta[]
  pedidos   Pedido[]

  oportunidades Oportunidade[]
  atividades    Atividade[]

  logo        LogoEmpresa?
  certificado CertificadoDigital?

  lancamentosEstoque LancamentoEstoque[]
  saldosEstoque      SaldoEstoque[]

  configuracaoFiscal  ConfiguracaoFiscal?
  cursoresCaptura     CursorCaptura[]
  documentosRecebidos DocumentoRecebido[]
  notasFiscais        NotaFiscal[]
  inutilizacoes       InutilizacaoNfe[]
  notasServico        NotaServico[]

  @@map("empresas")
}

model Usuario {
  id               String    @id @default(cuid())
  nome             String
  email            String    @unique
  senhaHash        String
  papel            Papel     @default(FINANCEIRO)
  ativo            Boolean   @default(true)
  trocarSenha      Boolean   @default(false)
  versaoSessao     Int       @default(1)
  ultimoAcesso     DateTime?
  tentativasFalhas Int       @default(0)
  bloqueadoAte     DateTime?
  /// Enxerga todas as empresas do grupo (admins sempre). Se falso, só as listadas em `empresas`.
  todasEmpresas    Boolean   @default(true)
  /// Ids das empresas (matrizes) liberadas quando `todasEmpresas` é falso.
  empresas         String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  auditorias Auditoria[]

  propostasVendedor Proposta[] @relation("VendedorProposta")
  pedidosVendedor   Pedido[]   @relation("VendedorPedido")

  oportunidadesResponsavel Oportunidade[] @relation("ResponsavelOportunidade")
  atividadesResponsavel    Atividade[]    @relation("ResponsavelAtividade")

  @@map("usuarios")
}

model Auditoria {
  id         String   @id @default(cuid())
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  acao       String
  entidade   String
  entidadeId String?
  resumo     String?
  dados      Json?
  ip         String?
  createdAt  DateTime @default(now())

  /// Empresa (matriz) do evento; nulo = evento do grupo (usuários com várias empresas, configuração geral).
  empresaId String?

  @@index([entidade, entidadeId])
  @@index([empresaId, createdAt])
  @@index([createdAt])
  @@map("auditoria")
}

// ───────────────────────── Cadastros ─────────────────────────

model Pessoa {
  id                 String      @id @default(cuid())
  /// Empresa (matriz) dona do cadastro; as filiais usam os cadastros da matriz.
  empresaId          String
  empresa            Empresa     @relation(fields: [empresaId], references: [id])
  tipoPessoa         TipoPessoa  @default(JURIDICA)
  documento          String?
  nome               String
  nomeFantasia       String?
  cliente            Boolean     @default(true)
  fornecedor         Boolean     @default(false)
  indicadorIE        IndicadorIE @default(NAO_CONTRIBUINTE)
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  email              String?
  telefone           String?
  contato            String?
  cep                String?
  logradouro         String?
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String?
  uf                 String?
  codigoMunicipio    String?
  limiteCredito      Decimal?    @db.Decimal(14, 2)
  observacoes        String?
  ativo              Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  titulos   Titulo[]
  regras    RegraConciliacao[]
  propostas Proposta[]
  pedidos   Pedido[]

  oportunidades Oportunidade[]
  atividades    Atividade[]

  lancamentosEstoque LancamentoEstoque[]

  documentosRecebidos DocumentoRecebido[]

  @@unique([empresaId, documento])
  @@index([empresaId, nome])
  @@map("pessoas")
}

model Produto {
  id                 String         @id @default(cuid())
  /// Empresa (matriz) dona do cadastro; as filiais usam os cadastros da matriz.
  empresaId          String
  empresa            Empresa        @relation(fields: [empresaId], references: [id])
  tipo               TipoProduto    @default(PRODUTO)
  codigo             String
  descricao          String
  unidade            String         @default("UN")
  gtin               String?
  ncm                String?
  cest               String?
  origem             Int            @default(0)
  codigoServico      String?
  precoVenda         Decimal        @default(0) @db.Decimal(14, 2)
  precoCusto         Decimal        @default(0) @db.Decimal(14, 4)
  controlaEstoque    Boolean        @default(true)
  estoqueMinimo      Decimal?       @db.Decimal(14, 4)
  estoqueMaximo      Decimal?       @db.Decimal(14, 4)
  /// grupo do material reciclável (PAPEL, PLASTICO, METAL_FERROSO...); vazio nos demais produtos
  grupoMaterial      String?
  /// NF-e: CFOP e CSOSN dentro e fora do estado (vazio = padrão do sistema) e texto legal para as informações complementares
  cfopInterno        String?
  cfopInterestadual  String?
  csosnInterno       String?
  csosnInterestadual String?
  textoFiscal        String?
  /// NFS-e nacional (serviços): código de tributação nacional (6 dígitos), municipal e NBS
  codigoTributacaoNacional  String?
  codigoTributacaoMunicipal String?
  codigoNbs                 String?
  observacoes        String?
  ativo              Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  itensProposta      PropostaItem[]
  itensPedido        PedidoItem[]
  itensEstoque       ItemEstoque[]
  saldosEstoque      SaldoEstoque[]

  @@unique([empresaId, codigo])
  @@index([empresaId, descricao])
  @@map("produtos")
}

model Categoria {
  id        String        @id @default(cuid())
  /// Empresa (matriz) dona do cadastro; as filiais usam os cadastros da matriz.
  empresaId String
  empresa   Empresa       @relation(fields: [empresaId], references: [id])
  codigo    String?
  nome      String
  tipo      TipoCategoria
  grupoDre  GrupoDRE
  ativo     Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  titulos Titulo[]
  rateios TituloRateio[]
  regras  RegraConciliacao[]

  @@unique([empresaId, tipo, nome])
  @@map("categorias")
}

model CentroCusto {
  id        String   @id @default(cuid())
  /// Empresa (matriz) dona do cadastro; as filiais usam os cadastros da matriz.
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  codigo    String?
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titulos Titulo[]
  rateios TituloRateio[]
  regras  RegraConciliacao[]

  @@unique([empresaId, nome])
  @@map("centros_custo")
}

model ContaBancaria {
  id               String    @id @default(cuid())
  empresaId        String
  empresa          Empresa   @relation(fields: [empresaId], references: [id])
  nome             String
  tipo             TipoConta @default(CORRENTE)
  bancoCodigo      String?
  bancoNome        String?
  agencia          String?
  numero           String?
  saldoInicial     Decimal   @default(0) @db.Decimal(14, 2)
  dataSaldoInicial DateTime  @db.Date
  ativo            Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  movimentos            Movimento[]
  titulos               Titulo[]
  baixas                Baixa[]
  importacoes           ExtratoImportacao[]
  extratoItens          ExtratoItem[]
  transferenciasOrigem  Transferencia[]     @relation("TransfOrigem")
  transferenciasDestino Transferencia[]     @relation("TransfDestino")

  @@map("contas_bancarias")
}

model FormaPagamento {
  id        String        @id @default(cuid())
  /// Empresa (matriz) dona do cadastro; as filiais usam os cadastros da matriz.
  empresaId String
  empresa   Empresa       @relation(fields: [empresaId], references: [id])
  nome      String
  meio      MeioPagamento @default(OUTRO)
  ativo     Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  titulos   Titulo[]
  baixas    Baixa[]
  propostas Proposta[]
  pedidos   Pedido[]

  @@unique([empresaId, nome])
  @@map("formas_pagamento")
}

model CondicaoPagamento {
  id        String     @id @default(cuid())
  /// Empresa (matriz) dona do cadastro; as filiais usam os cadastros da matriz.
  empresaId String
  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  nome      String
  dias      String
  ativo     Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  propostas Proposta[]
  pedidos   Pedido[]

  @@unique([empresaId, nome])
  @@map("condicoes_pagamento")
}

// ───────────────────────── Financeiro ─────────────────────────

model Titulo {
  id                 String          @id @default(cuid())
  numero             Int             @unique @default(autoincrement())
  tipo               TipoTitulo
  status             StatusTitulo    @default(ABERTO)
  origem             OrigemTitulo    @default(MANUAL)
  origemId           String?
  empresaId          String
  empresa            Empresa         @relation(fields: [empresaId], references: [id])
  pessoaId           String?
  pessoa             Pessoa?         @relation(fields: [pessoaId], references: [id])
  descricao          String
  documento          String?
  categoriaId        String?
  categoria          Categoria?      @relation(fields: [categoriaId], references: [id])
  centroCustoId      String?
  centroCusto        CentroCusto?    @relation(fields: [centroCustoId], references: [id])
  contaBancariaId    String?
  contaBancaria      ContaBancaria?  @relation(fields: [contaBancariaId], references: [id])
  formaPagamentoId   String?
  formaPagamento     FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])
  emissao            DateTime        @db.Date
  competencia        DateTime        @db.Date
  vencimento         DateTime        @db.Date
  valor              Decimal         @db.Decimal(14, 2)
  valorPago          Decimal         @default(0) @db.Decimal(14, 2)
  parcela            Int             @default(1)
  totalParcelas      Int             @default(1)
  grupoId            String?
  observacoes        String?
  quitadoEm          DateTime?       @db.Date
  canceladoEm        DateTime?
  motivoCancelamento String?
  criadoPorId        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  rateios TituloRateio[]
  baixas  Baixa[]
  anexos  Anexo[]

  @@index([tipo, status, vencimento])
  @@index([pessoaId])
  @@index([grupoId])
  @@index([competencia])
  @@map("titulos")
}

model TituloRateio {
  id            String       @id @default(cuid())
  tituloId      String
  titulo        Titulo       @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  categoriaId   String
  categoria     Categoria    @relation(fields: [categoriaId], references: [id])
  centroCustoId String?
  centroCusto   CentroCusto? @relation(fields: [centroCustoId], references: [id])
  percentual    Decimal      @db.Decimal(7, 4)
  valor         Decimal      @db.Decimal(14, 2)

  @@index([tituloId])
  @@index([categoriaId])
  @@map("titulo_rateios")
}

model Baixa {
  id               String          @id @default(cuid())
  tituloId         String
  titulo           Titulo          @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  contaBancariaId  String
  contaBancaria    ContaBancaria   @relation(fields: [contaBancariaId], references: [id])
  formaPagamentoId String?
  formaPagamento   FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])
  data             DateTime        @db.Date
  valor            Decimal         @db.Decimal(14, 2)
  juros            Decimal         @default(0) @db.Decimal(14, 2)
  multa            Decimal         @default(0) @db.Decimal(14, 2)
  desconto         Decimal         @default(0) @db.Decimal(14, 2)
  valorTotal       Decimal         @db.Decimal(14, 2)
  observacao       String?
  estornada        Boolean         @default(false)
  estornadaEm      DateTime?
  criadoPorId      String?
  createdAt        DateTime        @default(now())

  movimento Movimento?

  @@index([tituloId])
  @@index([data])
  @@map("baixas")
}

model Movimento {
  id              String          @id @default(cuid())
  contaBancariaId String
  contaBancaria   ContaBancaria   @relation(fields: [contaBancariaId], references: [id])
  data            DateTime        @db.Date
  tipo            TipoMovimento
  valor           Decimal         @db.Decimal(14, 2)
  descricao       String
  origem          OrigemMovimento
  baixaId         String?         @unique
  baixa           Baixa?          @relation(fields: [baixaId], references: [id], onDelete: Cascade)
  transferenciaId String?
  transferencia   Transferencia?  @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  conciliado      Boolean         @default(false)
  criadoPorId     String?
  createdAt       DateTime        @default(now())

  extratoItem ExtratoItem?

  @@index([contaBancariaId, data])
  @@index([data])
  @@map("movimentos")
}

model Transferencia {
  id             String        @id @default(cuid())
  contaOrigemId  String
  contaOrigem    ContaBancaria @relation("TransfOrigem", fields: [contaOrigemId], references: [id])
  contaDestinoId String
  contaDestino   ContaBancaria @relation("TransfDestino", fields: [contaDestinoId], references: [id])
  data           DateTime      @db.Date
  valor          Decimal       @db.Decimal(14, 2)
  descricao      String?
  criadoPorId    String?
  createdAt      DateTime      @default(now())

  movimentos Movimento[]

  @@map("transferencias")
}

model ExtratoImportacao {
  id              String        @id @default(cuid())
  contaBancariaId String
  contaBancaria   ContaBancaria @relation(fields: [contaBancariaId], references: [id])
  arquivoNome     String
  dataInicio      DateTime?     @db.Date
  dataFim         DateTime?     @db.Date
  saldoFinal      Decimal?      @db.Decimal(14, 2)
  dataSaldo       DateTime?     @db.Date
  totalItens      Int           @default(0)
  novosItens      Int           @default(0)
  criadoPorId     String?
  createdAt       DateTime      @default(now())

  itens ExtratoItem[]

  @@map("extrato_importacoes")
}

model ExtratoItem {
  id              String            @id @default(cuid())
  importacaoId    String
  importacao      ExtratoImportacao @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  contaBancariaId String
  contaBancaria   ContaBancaria     @relation(fields: [contaBancariaId], references: [id])
  fitId           String
  data            DateTime          @db.Date
  valor           Decimal           @db.Decimal(14, 2)
  descricao       String
  documento       String?
  status          StatusExtratoItem @default(PENDENTE)
  movimentoId     String?           @unique
  movimento       Movimento?        @relation(fields: [movimentoId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())

  @@unique([contaBancariaId, fitId])
  @@index([contaBancariaId, status, data])
  @@map("extrato_itens")
}

model RegraConciliacao {
  id            String       @id @default(cuid())
  /// Empresa (matriz) dona do cadastro; as filiais usam os cadastros da matriz.
  empresaId     String
  empresa       Empresa      @relation(fields: [empresaId], references: [id])
  termo         String
  tipo          TipoTitulo?
  categoriaId   String
  categoria     Categoria    @relation(fields: [categoriaId], references: [id])
  pessoaId      String?
  pessoa        Pessoa?      @relation(fields: [pessoaId], references: [id])
  centroCustoId String?
  centroCusto   CentroCusto? @relation(fields: [centroCustoId], references: [id])
  ativo         Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([empresaId])
  @@map("regras_conciliacao")
}

model Anexo {
  id          String   @id @default(cuid())
  tituloId    String?
  titulo      Titulo?  @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  nome        String
  mimeType    String
  tamanho     Int
  storage     String   @default("db")
  caminho     String?
  dados       Bytes?
  criadoPorId String?
  createdAt   DateTime @default(now())

  @@index([tituloId])
  @@map("anexos")
}

// ───────────────────────── Vendas (Fase 2) ─────────────────────────

enum StatusProposta {
  RASCUNHO
  ENVIADA
  APROVADA
  RECUSADA
  CANCELADA
}

enum StatusPedido {
  ABERTO
  FATURADO
  CANCELADO
}

/// Numeração sequencial por estabelecimento (CNPJ) e tipo de documento ("proposta", "pedido").
model SequenciaDocumento {
  empresaId String
  tipo      String
  ultimo    Int    @default(0)

  @@id([empresaId, tipo])
  @@map("sequencias_documento")
}

/// Proposta comercial (orçamento). `empresaId` é o estabelecimento emissor (matriz ou filial); os cadastros
/// usados (cliente, produtos, condição e forma) são da matriz.
model Proposta {
  id                  String             @id @default(cuid())
  empresaId           String
  empresa             Empresa            @relation(fields: [empresaId], references: [id])
  numero              Int
  status              StatusProposta     @default(RASCUNHO)
  pessoaId            String
  pessoa              Pessoa             @relation(fields: [pessoaId], references: [id])
  vendedorId          String?
  vendedor            Usuario?           @relation("VendedorProposta", fields: [vendedorId], references: [id])
  emissao             DateTime           @db.Date
  validade            DateTime           @db.Date
  condicaoPagamentoId String?
  condicaoPagamento   CondicaoPagamento? @relation(fields: [condicaoPagamentoId], references: [id])
  formaPagamentoId    String?
  formaPagamento      FormaPagamento?    @relation(fields: [formaPagamentoId], references: [id])
  /// texto para o cliente (sai no PDF)
  observacoes         String?
  /// anotações internas (não saem no PDF)
  observacoesInternas String?
  subtotal            Decimal            @default(0) @db.Decimal(14, 2)
  desconto            Decimal            @default(0) @db.Decimal(14, 2)
  total               Decimal            @default(0) @db.Decimal(14, 2)
  motivoRecusa        String?
  enviadaEm           DateTime?
  aprovadaEm          DateTime?
  recusadaEm          DateTime?
  canceladaEm         DateTime?
  /// oportunidade do CRM de onde a proposta saiu (aprovar a proposta marca a oportunidade como ganha)
  oportunidadeId      String?
  oportunidade        Oportunidade?      @relation(fields: [oportunidadeId], references: [id], onDelete: SetNull)
  criadoPorId         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  itens  PropostaItem[]
  pedido Pedido?

  @@unique([empresaId, numero])
  @@index([empresaId, status, emissao])
  @@index([pessoaId])
  @@index([oportunidadeId])
  @@map("propostas")
}

model PropostaItem {
  id                 String      @id @default(cuid())
  propostaId         String
  proposta           Proposta    @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  ordem              Int
  produtoId          String?
  produto            Produto?    @relation(fields: [produtoId], references: [id])
  tipo               TipoProduto
  descricao          String
  unidade            String
  quantidade         Decimal     @db.Decimal(14, 3)
  precoUnitario      Decimal     @db.Decimal(14, 4)
  descontoPercentual Decimal     @default(0) @db.Decimal(5, 2)
  total              Decimal     @db.Decimal(14, 2)

  @@index([propostaId, ordem])
  @@map("proposta_itens")
}

/// Pedido de venda. Pode nascer de uma proposta aprovada ou direto (venda de recicláveis, por exemplo).
/// Faturar gera as contas a receber (origem VENDA, origemId = id do pedido).
model Pedido {
  id                  String             @id @default(cuid())
  empresaId           String
  empresa             Empresa            @relation(fields: [empresaId], references: [id])
  numero              Int
  status              StatusPedido       @default(ABERTO)
  propostaId          String?            @unique
  proposta            Proposta?          @relation(fields: [propostaId], references: [id])
  pessoaId            String
  pessoa              Pessoa             @relation(fields: [pessoaId], references: [id])
  vendedorId          String?
  vendedor            Usuario?           @relation("VendedorPedido", fields: [vendedorId], references: [id])
  emissao             DateTime           @db.Date
  condicaoPagamentoId String?
  condicaoPagamento   CondicaoPagamento? @relation(fields: [condicaoPagamentoId], references: [id])
  formaPagamentoId    String?
  formaPagamento      FormaPagamento?    @relation(fields: [formaPagamentoId], references: [id])
  observacoes         String?
  observacoesInternas String?
  subtotal            Decimal            @default(0) @db.Decimal(14, 2)
  desconto            Decimal            @default(0) @db.Decimal(14, 2)
  total               Decimal            @default(0) @db.Decimal(14, 2)
  faturadoEm          DateTime?
  /// data escolhida no faturamento (emissão das contas a receber e da baixa no estoque)
  dataFaturamento     DateTime?          @db.Date
  canceladoEm         DateTime?
  motivoCancelamento  String?
  criadoPorId         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  itens             PedidoItem[]
  lancamentoEstoque LancamentoEstoque?
  notasFiscais      NotaFiscal[]
  notasServico      NotaServico[]

  @@unique([empresaId, numero])
  @@index([empresaId, status, emissao])
  @@index([empresaId, status, dataFaturamento])
  @@index([pessoaId])
  @@map("pedidos")
}

model PedidoItem {
  id                 String      @id @default(cuid())
  pedidoId           String
  pedido             Pedido      @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  ordem              Int
  produtoId          String?
  produto            Produto?    @relation(fields: [produtoId], references: [id])
  tipo               TipoProduto
  descricao          String
  unidade            String
  quantidade         Decimal     @db.Decimal(14, 3)
  precoUnitario      Decimal     @db.Decimal(14, 4)
  descontoPercentual Decimal     @default(0) @db.Decimal(5, 2)
  total              Decimal     @db.Decimal(14, 2)

  @@index([pedidoId, ordem])
  @@map("pedido_itens")
}

// ───────────────────────── CRM (Fase 2) ─────────────────────────

/// Etapas do funil. GANHA e PERDIDA fecham a oportunidade.
enum EtapaOportunidade {
  DESCOBERTA
  PROPOSTA
  NEGOCIACAO
  GANHA
  PERDIDA
}

enum TipoAtividade {
  LIGACAO
  WHATSAPP
  EMAIL
  REUNIAO
  VISITA
  TAREFA
}

/// Negócio em andamento com um cliente (ou lead). Pertence à empresa (matriz) ativa.
model Oportunidade {
  id                 String             @id @default(cuid())
  empresaId          String
  empresa            Empresa            @relation(fields: [empresaId], references: [id])
  titulo             String
  pessoaId           String
  pessoa             Pessoa             @relation(fields: [pessoaId], references: [id])
  /// com quem se fala no cliente (nome, cargo, telefone)
  contato            String?
  responsavelId      String?
  responsavel        Usuario?           @relation("ResponsavelOportunidade", fields: [responsavelId], references: [id], onDelete: SetNull)
  etapa              EtapaOportunidade  @default(DESCOBERTA)
  /// quando entrou na etapa atual (dias parados na etapa)
  etapaDesde         DateTime           @default(now())
  /// etapa em que estava ao ser ganha ou perdida (para reabrir no mesmo ponto)
  etapaAntesFechar   EtapaOportunidade?
  valor              Decimal            @default(0) @db.Decimal(14, 2)
  previsaoFechamento DateTime?          @db.Date
  /// código da origem do lead (lista fixa no módulo crm)
  origem             String?
  /// código do motivo de perda (lista fixa no módulo crm)
  motivoPerda        String?
  detalhePerda       String?
  observacoes        String?
  ganhaEm            DateTime?
  perdidaEm          DateTime?
  criadoPorId        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  atividades Atividade[]
  propostas  Proposta[]

  @@index([empresaId, etapa])
  @@index([pessoaId])
  @@index([responsavelId])
  @@map("oportunidades")
}

/// Ligação, reunião, tarefa etc. Pode estar ligada a uma oportunidade e/ou a um cliente.
model Atividade {
  id             String        @id @default(cuid())
  empresaId      String
  empresa        Empresa       @relation(fields: [empresaId], references: [id])
  tipo           TipoAtividade @default(TAREFA)
  assunto        String
  descricao      String?
  data           DateTime      @db.Date
  /// "HH:MM" opcional
  hora           String?
  responsavelId  String?
  responsavel    Usuario?      @relation("ResponsavelAtividade", fields: [responsavelId], references: [id], onDelete: SetNull)
  oportunidadeId String?
  oportunidade   Oportunidade? @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  pessoaId       String?
  pessoa         Pessoa?       @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  concluidaEm    DateTime?
  criadoPorId    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([empresaId, concluidaEm, data])
  @@index([responsavelId, concluidaEm, data])
  @@index([oportunidadeId])
  @@index([pessoaId])
  @@map("atividades")
}

/// Logotipo da empresa (matriz): sai no cabeçalho dos PDFs dela e das filiais.
/// Fica numa tabela à parte para as consultas de empresa não carregarem a imagem.
model LogoEmpresa {
  empresaId       String   @id
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// PNG ou JPEG já tratado no navegador (margens cortadas, até 1200 x 600 px)
  imagem          Bytes
  /// "png" ou "jpeg"
  formato         String
  largura         Int
  altura          Int
  atualizadoPorId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("logos_empresa")
}

// ───────────────────────── Estoque (Fase 3) ─────────────────────────

enum TipoLancamentoEstoque {
  /// entrada da produção ou triagem
  ENTRADA
  /// saída automática ao faturar o pedido de venda
  VENDA
  /// inventário ou correção (cada item pode entrar ou sair)
  AJUSTE
}

/// Lançamento de estoque num estabelecimento (matriz ou filial), com um item por material.
model LancamentoEstoque {
  id          String                @id @default(cuid())
  empresaId   String
  empresa     Empresa               @relation(fields: [empresaId], references: [id])
  /// numeração própria por estabelecimento
  numero      Int
  tipo        TipoLancamentoEstoque
  data        DateTime              @db.Date
  /// venda: pedido faturado que gerou a saída (desfazer o faturamento exclui o lançamento)
  pedidoId    String?               @unique
  pedido      Pedido?               @relation(fields: [pedidoId], references: [id])
  /// entrada: cliente de onde veio o material (rastreabilidade)
  pessoaId    String?
  pessoa      Pessoa?               @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  /// processo de destruição, MTR, lote ou ticket de pesagem
  referencia  String?
  /// ajuste: código do motivo (lista fixa no módulo estoque)
  motivo      String?
  observacao  String?
  criadoPorId String?
  createdAt   DateTime              @default(now())

  itens ItemEstoque[]

  @@unique([empresaId, numero])
  @@index([empresaId, tipo, data])
  @@map("lancamentos_estoque")
}

model ItemEstoque {
  id           String            @id @default(cuid())
  lancamentoId String
  lancamento   LancamentoEstoque @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  produtoId    String
  produto      Produto           @relation(fields: [produtoId], references: [id])
  /// positivo entra, negativo sai (na unidade do produto)
  quantidade   Decimal           @db.Decimal(14, 3)
  /// ajuste: saldo contado no inventário
  saldoContado Decimal?          @db.Decimal(14, 3)

  @@index([lancamentoId])
  @@index([produtoId])
  @@map("itens_estoque")
}

/// Saldo atual de cada material por estabelecimento. Sempre igual à soma dos itens; nunca negativo.
model SaldoEstoque {
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  produtoId  String
  produto    Produto  @relation(fields: [produtoId], references: [id])
  quantidade Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt  DateTime @updatedAt

  @@id([empresaId, produtoId])
  @@index([produtoId])
  @@map("saldos_estoque")
}

/// Certificado digital A1 do estabelecimento (CNPJ), para emitir NF-e e NFS-e (Fase 4).
/// Arquivo e senha ficam cifrados (AES-256-GCM, chave CERTIFICADOS_CHAVE do servidor, com o id da empresa
/// autenticado junto) e nunca saem do servidor. A filial sem certificado próprio usa o da matriz.
model CertificadoDigital {
  empresaId        String   @id
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  arquivoCifrado   Bytes
  senhaCifrada     Bytes
  /// nome do titular (CN sem o CNPJ)
  titular          String
  /// CNPJ do certificado (14 dígitos)
  cnpj             String?
  /// autoridade certificadora emissora
  emissor          String?
  numeroSerie      String
  /// SHA-256 do certificado (hex)
  impressaoDigital String
  validoDe         DateTime
  validoAte        DateTime
  enviadoPorId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([validoAte])
  @@map("certificados_digitais")
}

// ───────────────────────── Fiscal: notas recebidas (Fase 4, etapa 1) ─────────────────────────
// Captação das notas emitidas contra o CNPJ (NF-e e CT-e pelo DistDFe da SEFAZ, NFS-e pelo Ambiente Nacional).
// Dois motores com a mesma interface: SEFAZ direto (padrão, sem custo) e Focus NFe (reserva, desligado).

enum MotorFiscal {
  SEFAZ
  FOCUS
}

enum TipoDocumentoFiscal {
  NFE
  CTE
  NFSE
}

/// Papel do estabelecimento no documento.
enum DirecaoDocumento {
  /// destinatário da NF-e, tomador do CT-e ou da NFS-e
  ENTRADA
  /// emitente ou prestador
  SAIDA
  /// transportador, remetente, autorizado no XML etc.
  TERCEIRO
}

enum SituacaoDocumento {
  AUTORIZADO
  CANCELADO
  DENEGADO
}

/// Manifestação do destinatário da NF-e.
enum Manifestacao {
  CIENCIA
  CONFIRMACAO
  DESCONHECIMENTO
  NAO_REALIZADA
}

/// Configuração fiscal por estabelecimento (um CNPJ). A captação nasce desligada: dois sistemas consultando a
/// SEFAZ para o mesmo CNPJ levam a bloqueio por consumo indevido (cStat 656).
model ConfiguracaoFiscal {
  empresaId             String      @id
  empresa               Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  captacaoAtiva         Boolean     @default(false)
  motor                 MotorFiscal @default(SEFAZ)
  /// 1 = produção, 2 = homologação
  ambiente              Int         @default(1)
  captarNfe             Boolean     @default(true)
  captarCte             Boolean     @default(true)
  captarNfse            Boolean     @default(true)
  cienciaAutomatica     Boolean     @default(true)
  /// trava de captura: uma execução por CNPJ (dono e validade)
  travaToken            String?
  travaAte              DateTime?
  /// Focus NFe (motor reserva): id da empresa lá e tokens cifrados (AES-256-GCM)
  focusEmpresaId        String?
  focusTokenProducao    Bytes?
  focusTokenHomologacao Bytes?
  focusAtivadaEm        DateTime?
  /// Emissão de NF-e (modelo 55): ambiente nasce em homologação (2) até o administrador trocar
  nfeAtiva              Boolean     @default(false)
  nfeAmbiente           Int         @default(2)
  nfeMotor              MotorFiscal @default(SEFAZ)
  nfeSerie              Int         @default(1)
  nfeProximoNumero      Int         @default(1)
  /// texto padrão das informações complementares (o do Simples Nacional vem preenchido)
  nfeInformacoes        String?
  /// Emissão de NFS-e pelo emissor nacional: ambiente 2 = produção restrita (testes), 1 = produção
  nfseAtiva             Boolean     @default(false)
  nfseAmbiente          Int         @default(2)
  nfseMotor             MotorFiscal @default(SEFAZ)
  nfseSerie             Int         @default(1)
  nfseProximoNumero     Int         @default(1)
  /// alíquota efetiva do Simples Nacional (pTotTribSN), em %, informada pelo contador
  nfseAliquotaSimples   Decimal     @default(6) @db.Decimal(5, 2)
  /// enviar a inscrição municipal na DPS (só quando o município cadastrou o contribuinte no CNC)
  nfseEnviarIM          Boolean     @default(false)
  nfseInformacoes       String?
  /// última conferência da adesão do município ao Emissor Nacional (ADN)
  nfseMunicipioAderente    Boolean?
  nfseMunicipioConferidoEm DateTime?
  atualizadoPorId       String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("configuracoes_fiscais")
}

/// Onde parou a captação de cada tipo, por estabelecimento e motor (NSU na SEFAZ, versão na Focus).
model CursorCaptura {
  id               String              @id @default(cuid())
  empresaId        String
  empresa          Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo             TipoDocumentoFiscal
  motor            MotorFiscal
  ultimoNsu        String              @default("0")
  maxNsu           String?
  consultadoEm     DateTime?
  /// cStat da última consulta real (137, 138, 656...) ou ERR
  status           String?
  mensagem         String?
  /// regra da SEFAZ: depois de "nenhum documento" (137) ou "consumo indevido" (656), só consultar de novo depois disto
  proximaConsulta  DateTime?
  /// a última execução parou antes do fim (teto de páginas ou de tempo)
  pendente         Boolean             @default(false)
  documentosUltima Int                 @default(0)
  updatedAt        DateTime            @updatedAt

  @@unique([empresaId, tipo, motor])
  @@map("cursores_captura")
}

model DocumentoRecebido {
  id                    String              @id @default(cuid())
  /// estabelecimento (CNPJ) contra o qual o documento foi emitido
  empresaId             String
  empresa               Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo                  TipoDocumentoFiscal
  /// chave de acesso (44 dígitos; NFS-e nacional tem 50)
  chave                 String
  direcao               DirecaoDocumento    @default(ENTRADA)
  numero                String?
  serie                 String?
  emitenteDocumento     String?
  emitenteNome          String?
  emitenteIe            String?
  destinatarioDocumento String?
  valor                 Decimal?            @db.Decimal(14, 2)
  emitidoEm             DateTime?
  situacao              SituacaoDocumento   @default(AUTORIZADO)
  protocolo             String?
  /// true quando o XML guardado é o documento completo; false = só o resumo (NF-e antes da manifestação)
  completo              Boolean             @default(false)
  xml                   String
  nsu                   String?
  motor                 MotorFiscal
  manifestacao          Manifestacao?
  manifestadoEm         DateTime?
  manifestacaoProtocolo String?
  manifestacaoErro      String?
  /// fornecedor vinculado (cadastro da matriz)
  pessoaId              String?
  pessoa                Pessoa?             @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  /// lançado no contas a pagar (títulos com origem NOTA_FISCAL e origemId = este id)
  lancadoEm             DateTime?
  lancadoPorId          String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  eventos EventoDocumento[]

  @@unique([empresaId, chave])
  @@index([empresaId, tipo, emitidoEm])
  @@index([empresaId, manifestacao])
  @@map("documentos_recebidos")
}

/// Eventos dos documentos recebidos (cancelamento, carta de correção, manifestações). Pode chegar antes do documento.
model EventoDocumento {
  id             String             @id @default(cuid())
  empresaId      String
  documentoId    String?
  documento      DocumentoRecebido? @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  chaveDocumento String
  /// código do evento (110111 cancelamento, 110110 carta de correção, 210210 ciência...)
  tipoEvento     String
  sequencia      Int                @default(1)
  descricao      String?
  /// texto da correção ou justificativa
  detalhe        String?
  ocorridoEm     DateTime?
  protocolo      String?
  xml            String
  nsu            String?
  createdAt      DateTime           @default(now())

  @@unique([empresaId, chaveDocumento, tipoEvento, sequencia])
  @@index([documentoId])
  @@map("eventos_documentos")
}

// ───────────────────────── Fiscal: emissão de NF-e (Fase 4, etapa 2) ─────────────────────────

enum StatusNotaFiscal {
  /// enviada, sem resposta definitiva (consultar)
  PROCESSANDO
  AUTORIZADA
  /// recusada pela SEFAZ: o número continua reservado para o reenvio corrigido (ou é inutilizado)
  REJEITADA
  DENEGADA
  CANCELADA
}

/// NF-e emitida pelo estabelecimento. O XML assinado e o autorizado (nfeProc) ficam guardados.
model NotaFiscal {
  id                        String           @id @default(cuid())
  empresaId                 String
  empresa                   Empresa          @relation(fields: [empresaId], references: [id])
  pedidoId                  String?
  pedido                    Pedido?          @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  modelo                    Int              @default(55)
  serie                     Int
  numero                    Int
  /// 1 produção, 2 homologação
  ambiente                  Int
  motor                     MotorFiscal
  /// 1 normal, 6 contingência SVC-AN
  tpEmis                    Int              @default(1)
  chave                     String?
  status                    StatusNotaFiscal @default(PROCESSANDO)
  cStat                     String?
  xMotivo                   String?
  protocolo                 String?
  emitidaEm                 DateTime
  autorizadaEm              DateTime?
  naturezaOperacao          String
  destinatarioNome          String
  destinatarioDocumento     String?
  valor                     Decimal          @db.Decimal(14, 2)
  /// XML assinado enviado (NFe) e XML autorizado (nfeProc)
  xml                       String?
  xmlAutorizado             String?
  contingenciaMotivo        String?
  canceladaEm               DateTime?
  cancelamentoProtocolo     String?
  cancelamentoJustificativa String?
  /// referência da nota na Focus NFe (motor reserva)
  focusRef                  String?
  emitidaPorId              String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  eventos EventoNotaFiscal[]

  @@unique([empresaId, modelo, serie, numero, ambiente])
  @@index([pedidoId])
  @@index([empresaId, emitidaEm])
  @@index([empresaId, status])
  @@map("notas_fiscais")
}

/// Eventos da NF-e emitida (cancelamento 110111, carta de correção 110110).
model EventoNotaFiscal {
  id           String     @id @default(cuid())
  notaId       String
  nota         NotaFiscal @relation(fields: [notaId], references: [id], onDelete: Cascade)
  tipoEvento   String
  sequencia    Int
  detalhe      String
  ok           Boolean
  cStat        String?
  xMotivo      String?
  protocolo    String?
  registradoEm DateTime?
  /// procEventoNFe (evento + retorno), quando registrado
  xml          String?
  usuarioId    String?
  createdAt    DateTime   @default(now())

  @@index([notaId])
  @@map("eventos_notas_fiscais")
}

/// Faixas de numeração inutilizadas na SEFAZ (números que não serão usados).
model InutilizacaoNfe {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  ambiente      Int
  serie         Int
  numeroInicial Int
  numeroFinal   Int
  justificativa String
  ok            Boolean
  cStat         String?
  xMotivo       String?
  protocolo     String?
  xml           String?
  usuarioId     String?
  createdAt     DateTime @default(now())

  @@index([empresaId, serie])
  @@map("inutilizacoes_nfe")
}

/// NFS-e emitida pelo emissor nacional (DPS → NFS-e). Uma nota por grupo de serviços do pedido com o mesmo código de tributação.
model NotaServico {
  id                       String           @id @default(cuid())
  empresaId                String
  empresa                  Empresa          @relation(fields: [empresaId], references: [id])
  pedidoId                 String?
  pedido                   Pedido?          @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  /// 1 = produção, 2 = produção restrita
  ambiente                 Int
  motor                    MotorFiscal
  serie                    Int
  /// nDPS (número da declaração; a NFS-e recebe outro número, dado pelo emissor nacional)
  numero                   Int
  idDps                    String?
  chave                    String?
  numeroNfse               String?
  status                   StatusNotaFiscal @default(PROCESSANDO)
  /// código do erro (E0039...) ou cStat da NFS-e
  codigo                   String?
  mensagem                 String?
  competencia              DateTime
  emitidaEm                DateTime
  autorizadaEm             DateTime?
  tomadorNome              String
  tomadorDocumento         String?
  codigoTributacaoNacional String
  descricao                String
  valor                    Decimal          @db.Decimal(14, 2)
  /// DPS assinada (enviada) e NFS-e devolvida pelo emissor nacional
  xml                      String?
  xmlAutorizado            String?
  canceladaEm              DateTime?
  cancelamentoCodigo       String?
  cancelamentoMotivo       String?
  cancelamentoXml          String?
  focusRef                 String?
  emitidaPorId             String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@unique([empresaId, serie, numero, ambiente])
  @@index([pedidoId])
  @@index([empresaId, emitidaEm])
  @@index([empresaId, status])
  @@map("notas_servico")
}

enum StatusEmail {
  PENDENTE
  ENVIADO
  FALHOU
}

/// Fila de e-mails transacionais (envio imediato com reenvio pelo cron). Anexos pequenos (PDF, XML) guardados em JSON base64.
model Email {
  id               String      @id @default(cuid())
  empresaId        String?
  tipo             String
  origemId         String?
  para             String
  copia            String?
  responderPara    String?
  assunto          String
  html             String
  texto            String
  /// [{ nome, tipo, base64 }]
  anexos           Json?
  status           StatusEmail @default(PENDENTE)
  tentativas       Int         @default(0)
  erro             String?
  provedorId       String?
  enviadoEm        DateTime?
  proximaTentativa DateTime?
  usuarioId        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status, proximaTentativa])
  @@index([empresaId, createdAt])
  @@index([tipo, origemId])
  @@map("emails")
}

/// Token de redefinição de senha ("esqueci minha senha"): só o hash fica guardado; vale 1 hora e uma vez.
model TokenSenha {
  id        String    @id @default(cuid())
  usuarioId String
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  @@index([usuarioId])
  @@map("tokens_senha")
}
