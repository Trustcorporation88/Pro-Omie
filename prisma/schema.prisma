// Pro Omie - schema do banco (Fases 0 e 1: fundação e financeiro; multiempresa com cadastros por empresa)
// Todas as tabelas ficam no schema "erp" do Postgres (fora da Data API do Supabase).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Papel {
  ADMIN
  FINANCEIRO
  VENDAS
  ESTOQUE
  CONTADOR
}

enum RegimeTributario {
  MEI
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

enum TipoPessoa {
  FISICA
  JURIDICA
  ESTRANGEIRA
}

enum IndicadorIE {
  CONTRIBUINTE
  ISENTO
  NAO_CONTRIBUINTE
}

enum TipoProduto {
  PRODUTO
  SERVICO
}

enum TipoCategoria {
  RECEITA
  DESPESA
}

enum GrupoDRE {
  RECEITA_BRUTA
  DEDUCOES
  CUSTOS
  DESPESAS_PESSOAL
  DESPESAS_ADMINISTRATIVAS
  DESPESAS_COMERCIAIS
  RECEITAS_FINANCEIRAS
  DESPESAS_FINANCEIRAS
  OUTRAS_RECEITAS
  OUTRAS_DESPESAS
  IMPOSTOS_LUCRO
  NAO_OPERACIONAL
}

enum TipoConta {
  CORRENTE
  POUPANCA
  CAIXA
  CARTAO_CREDITO
  INVESTIMENTO
  CONTA_PAGAMENTO
}

enum MeioPagamento {
  DINHEIRO
  PIX
  BOLETO
  CARTAO_CREDITO
  CARTAO_DEBITO
  TRANSFERENCIA
  CHEQUE
  DEBITO_AUTOMATICO
  OUTRO
}

enum TipoTitulo {
  RECEBER
  PAGAR
}

enum StatusTitulo {
  ABERTO
  PARCIAL
  QUITADO
  CANCELADO
}

enum OrigemTitulo {
  MANUAL
  RECORRENCIA
  CONCILIACAO
  VENDA
  COMPRA
  CONTRATO
  NOTA_FISCAL
}

enum TipoMovimento {
  CREDITO
  DEBITO
}

enum OrigemMovimento {
  BAIXA
  TRANSFERENCIA
  AJUSTE
}

enum StatusExtratoItem {
  PENDENTE
  CONCILIADO
  IGNORADO
}

// ───────────────────────── Empresa e acesso ─────────────────────────

model Empresa {
  id                 String           @id @default(cuid())
  razaoSocial        String
  nomeFantasia       String?
  cnpj               String           @unique
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  regimeTributario   RegimeTributario @default(SIMPLES_NACIONAL)
  cnae               String?
  email              String?
  telefone           String?
  cep                String?
  logradouro         String?
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String?
  uf                 String?
  codigoMunicipio    String?
  matrizId           String?
  matriz             Empresa?         @relation("Filiais", fields: [matrizId], references: [id])
  filiais            Empresa[]        @relation("Filiais")
  ativo              Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  contasBancarias ContaBancaria[]
  titulos         Titulo[]
  pessoas         Pessoa[]
  produtos        Produto[]
  categorias      Categoria[]
  centrosCusto    CentroCusto[]
  formasPagamento FormaPagamento[]
  condicoes       CondicaoPagamento[]
  regras          RegraConciliacao[]

  propostas Proposta[]
  pedidos   Pedido[]

  oportunidades Oportunidade[]
  atividades    Atividade[]

  logo        LogoEmpresa?
  certificado CertificadoDigital?

  lancamentosEstoque LancamentoEstoque[]
  saldosEstoque      SaldoEstoque[]

  configuracaoFiscal   ConfiguracaoFiscal?
  cursoresCaptura      CursorCaptura[]
  documentosRecebidos  DocumentoRecebido[]
  notasFiscais         NotaFiscal[]
  inutilizacoes        InutilizacaoNfe[]
  notasServico         NotaServico[]
  configuracaoCobranca ConfiguracaoCobranca?
  cobrancas            Cobranca[]
  contratos            Contrato[]
  ordensServico        OrdemServico[]

  enderecosArmazem    EnderecoArmazem[]
  produtosDepositante ProdutoDepositante[]
  recebimentosArmazem RecebimentoArmazem[]
  volumesArmazem      VolumeArmazem[]

  tarifasArmazem      TarifaArmazem[]
  faturamentosArmazem FaturamentoArmazem[]

  @@map("empresas")
}

model Usuario {
  id               String    @id @default(cuid())
  nome             String
  email            String    @unique
  senhaHash        String
  papel            Papel     @default(FINANCEIRO)
  ativo            Boolean   @default(true)
  trocarSenha      Boolean   @default(false)
  versaoSessao     Int       @default(1)
  ultimoAcesso     DateTime?
  tentativasFalhas Int       @default(0)
  bloqueadoAte     DateTime?
  /// Enxerga todas as empresas do grupo (admins sempre). Se falso, só as listadas em `empresas`.
  todasEmpresas    Boolean   @default(true)
  /// Ids das empresas (matrizes) liberadas quando `todasEmpresas` é falso.
  empresas         String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  auditorias Auditoria[]

  propostasVendedor Proposta[] @relation("VendedorProposta")
  pedidosVendedor   Pedido[]   @relation("VendedorPedido")

  oportunidadesResponsavel Oportunidade[] @relation("ResponsavelOportunidade")
  atividadesResponsavel    Atividade[]    @relation("ResponsavelAtividade")

  @@map("usuarios")
}

model Auditoria {
  id         String   @id @default(cuid())
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  acao       String
  entidade   String
  entidadeId String?
  resumo     String?
  dados      Json?
  ip         String?
  createdAt  DateTime @default(now())

  /// Empresa (matriz) do evento; nulo = evento do grupo (usuários com várias empresas, configuração geral).
  empresaId String?

  @@index([entidade, entidadeId])
  @@index([empresaId, createdAt])
  @@index([createdAt])
  @@map("auditoria")
}

// ───────────────────────── Cadastros ─────────────────────────

model Pessoa {
  id                 String      @id @default(cuid())
  /// Empresa (matriz) dona do cadastro; as filiais usam os cadastros da matriz.
  empresaId          String
  empresa            Empresa     @relation(fields: [empresaId], references: [id])
  tipoPessoa         TipoPessoa  @default(JURIDICA)
  documento          String?
  nome               String
  nomeFantasia       String?
  cliente            Boolean     @default(true)
  fornecedor         Boolean     @default(false)
  indicadorIE        IndicadorIE @default(NAO_CONTRIBUINTE)
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  email              String?
  telefone           String?
  contato            String?
  cep                String?
  logradouro         String?
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String?
  uf                 String?
  codigoMunicipio    String?
  limiteCredito      Decimal?    @db.Decimal(14, 2)
  observacoes        String?
  ativo              Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  titulos   Titulo[]
  regras    RegraConciliacao[]
  propostas Proposta[]
  pedidos   Pedido[]

  oportunidades Oportunidade[]
  atividades    Atividade[]

  lancamentosEstoque LancamentoEstoque[]

  documentosRecebidos DocumentoRecebido[]

  produtosDepositante ProdutoDepositante[]
  recebimentosArmazem RecebimentoArmazem[]
  volumesArmazem      VolumeArmazem[]
  enderecosReservados EnderecoArmazem[]
  contratos           Contrato[]
  ordensServico       OrdemServico[]

  tarifasArmazem      TarifaArmazem[]
  faturamentosArmazem FaturamentoArmazem[]

  @@unique([empresaId, documento])
  @@index([empresaId, nome])
  @@map("pessoas")
}

model Produto {
  id                        String                     @id @default(cuid())
  /// Empresa (matriz) dona do cadastro; as filiais usam os cadastros da matriz.
  empresaId                 String
  empresa                   Empresa                    @relation(fields: [empresaId], references: [id])
  tipo                      TipoProduto                @default(PRODUTO)
  codigo                    String
  descricao                 String
  unidade                   String                     @default("UN")
  gtin                      String?
  ncm                       String?
  cest                      String?
  origem                    Int                        @default(0)
  codigoServico             String?
  precoVenda                Decimal                    @default(0) @db.Decimal(14, 2)
  precoCusto                Decimal                    @default(0) @db.Decimal(14, 4)
  controlaEstoque           Boolean                    @default(true)
  estoqueMinimo             Decimal?                   @db.Decimal(14, 4)
  estoqueMaximo             Decimal?                   @db.Decimal(14, 4)
  /// grupo do material reciclável (PAPEL, PLASTICO, METAL_FERROSO...); vazio nos demais produtos
  grupoMaterial             String?
  /// NF-e: CFOP e CSOSN dentro e fora do estado (vazio = padrão do sistema) e texto legal para as informações complementares
  cfopInterno               String?
  cfopInterestadual         String?
  csosnInterno              String?
  csosnInterestadual        String?
  /// CST do IBS/CBS (3 dígitos). Vazio = 000 (tributação integral)
  cstIbsCbs                 String?
  /// código de classificação tributária do IBS/CBS (6 dígitos). Vazio = 000001
  cClassTrib                String?
  textoFiscal               String?
  /// NFS-e nacional (serviços): código de tributação nacional (6 dígitos), municipal e NBS
  codigoTributacaoNacional  String?
  codigoTributacaoMunicipal String?
  codigoNbs                 String?
  observacoes               String?
  ativo                     Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  itensProposta             PropostaItem[]
  itensPedido               PedidoItem[]
  itensEstoque              ItemEstoque[]
  saldosEstoque             SaldoEstoque[]
  contratos                 Contrato[]
  ordensServico             OrdemServico[]
  vinculosFornecedor        VinculoProdutoFornecedor[]

  tarifasArmazem TarifaArmazem[]

  @@unique([empresaId, codigo])
  @@index([empresaId, descricao])
  @@map("produtos")
}

model Categoria {
  id        String        @id @default(cuid())
  /// Empresa (matriz) dona do cadastro; as filiais usam os cadastros da matriz.
  empresaId String
  empresa   Empresa       @relation(fields: [empresaId], references: [id])
  codigo    String?
  nome      String
  tipo      TipoCategoria
  grupoDre  GrupoDRE
  ativo     Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  titulos Titulo[]
  rateios TituloRateio[]
  regras  RegraConciliacao[]

  @@unique([empresaId, tipo, nome])
  @@map("categorias")
}

model CentroCusto {
  id        String   @id @default(cuid())
  /// Empresa (matriz) dona do cadastro; as filiais usam os cadastros da matriz.
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  codigo    String?
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titulos Titulo[]
  rateios TituloRateio[]
  regras  RegraConciliacao[]

  @@unique([empresaId, nome])
  @@map("centros_custo")
}

model ContaBancaria {
  id               String    @id @default(cuid())
  empresaId        String
  empresa          Empresa   @relation(fields: [empresaId], references: [id])
  nome             String
  tipo             TipoConta @default(CORRENTE)
  bancoCodigo      String?
  bancoNome        String?
  agencia          String?
  numero           String?
  saldoInicial     Decimal   @default(0) @db.Decimal(14, 2)
  dataSaldoInicial DateTime  @db.Date
  ativo            Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  movimentos            Movimento[]
  titulos               Titulo[]
  baixas                Baixa[]
  importacoes           ExtratoImportacao[]
  extratoItens          ExtratoItem[]
  transferenciasOrigem  Transferencia[]     @relation("TransfOrigem")
  transferenciasDestino Transferencia[]     @relation("TransfDestino")

  @@map("contas_bancarias")
}

model FormaPagamento {
  id        String        @id @default(cuid())
  /// Empresa (matriz) dona do cadastro; as filiais usam os cadastros da matriz.
  empresaId String
  empresa   Empresa       @relation(fields: [empresaId], references: [id])
  nome      String
  meio      MeioPagamento @default(OUTRO)
  ativo     Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  titulos   Titulo[]
  baixas    Baixa[]
  propostas Proposta[]
  pedidos   Pedido[]

  @@unique([empresaId, nome])
  @@map("formas_pagamento")
}

model CondicaoPagamento {
  id        String     @id @default(cuid())
  /// Empresa (matriz) dona do cadastro; as filiais usam os cadastros da matriz.
  empresaId String
  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  nome      String
  dias      String
  ativo     Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  propostas Proposta[]
  pedidos   Pedido[]

  @@unique([empresaId, nome])
  @@map("condicoes_pagamento")
}

// ───────────────────────── Financeiro ─────────────────────────

model Titulo {
  id                 String          @id @default(cuid())
  numero             Int             @unique @default(autoincrement())
  tipo               TipoTitulo
  status             StatusTitulo    @default(ABERTO)
  origem             OrigemTitulo    @default(MANUAL)
  origemId           String?
  empresaId          String
  empresa            Empresa         @relation(fields: [empresaId], references: [id])
  pessoaId           String?
  pessoa             Pessoa?         @relation(fields: [pessoaId], references: [id])
  descricao          String
  documento          String?
  categoriaId        String?
  categoria          Categoria?      @relation(fields: [categoriaId], references: [id])
  centroCustoId      String?
  centroCusto        CentroCusto?    @relation(fields: [centroCustoId], references: [id])
  contaBancariaId    String?
  contaBancaria      ContaBancaria?  @relation(fields: [contaBancariaId], references: [id])
  formaPagamentoId   String?
  formaPagamento     FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])
  emissao            DateTime        @db.Date
  competencia        DateTime        @db.Date
  vencimento         DateTime        @db.Date
  valor              Decimal         @db.Decimal(14, 2)
  valorPago          Decimal         @default(0) @db.Decimal(14, 2)
  parcela            Int             @default(1)
  totalParcelas      Int             @default(1)
  grupoId            String?
  observacoes        String?
  quitadoEm          DateTime?       @db.Date
  canceladoEm        DateTime?
  motivoCancelamento String?
  criadoPorId        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  rateios   TituloRateio[]
  baixas    Baixa[]
  anexos    Anexo[]
  cobrancas Cobranca[]

  @@index([tipo, status, vencimento])
  @@index([pessoaId])
  @@index([grupoId])
  @@index([competencia])
  @@map("titulos")
}

model TituloRateio {
  id            String       @id @default(cuid())
  tituloId      String
  titulo        Titulo       @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  categoriaId   String
  categoria     Categoria    @relation(fields: [categoriaId], references: [id])
  centroCustoId String?
  centroCusto   CentroCusto? @relation(fields: [centroCustoId], references: [id])
  percentual    Decimal      @db.Decimal(7, 4)
  valor         Decimal      @db.Decimal(14, 2)

  @@index([tituloId])
  @@index([categoriaId])
  @@map("titulo_rateios")
}

model Baixa {
  id               String          @id @default(cuid())
  tituloId         String
  titulo           Titulo          @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  contaBancariaId  String
  contaBancaria    ContaBancaria   @relation(fields: [contaBancariaId], references: [id])
  formaPagamentoId String?
  formaPagamento   FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])
  data             DateTime        @db.Date
  valor            Decimal         @db.Decimal(14, 2)
  juros            Decimal         @default(0) @db.Decimal(14, 2)
  multa            Decimal         @default(0) @db.Decimal(14, 2)
  desconto         Decimal         @default(0) @db.Decimal(14, 2)
  valorTotal       Decimal         @db.Decimal(14, 2)
  observacao       String?
  estornada        Boolean         @default(false)
  estornadaEm      DateTime?
  criadoPorId      String?
  createdAt        DateTime        @default(now())

  movimento Movimento?

  @@index([tituloId])
  @@index([data])
  @@map("baixas")
}

model Movimento {
  id              String          @id @default(cuid())
  contaBancariaId String
  contaBancaria   ContaBancaria   @relation(fields: [contaBancariaId], references: [id])
  data            DateTime        @db.Date
  tipo            TipoMovimento
  valor           Decimal         @db.Decimal(14, 2)
  descricao       String
  origem          OrigemMovimento
  baixaId         String?         @unique
  baixa           Baixa?          @relation(fields: [baixaId], references: [id], onDelete: Cascade)
  transferenciaId String?
  transferencia   Transferencia?  @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  conciliado      Boolean         @default(false)
  criadoPorId     String?
  createdAt       DateTime        @default(now())

  extratoItem ExtratoItem?

  @@index([contaBancariaId, data])
  @@index([data])
  @@map("movimentos")
}

model Transferencia {
  id             String        @id @default(cuid())
  contaOrigemId  String
  contaOrigem    ContaBancaria @relation("TransfOrigem", fields: [contaOrigemId], references: [id])
  contaDestinoId String
  contaDestino   ContaBancaria @relation("TransfDestino", fields: [contaDestinoId], references: [id])
  data           DateTime      @db.Date
  valor          Decimal       @db.Decimal(14, 2)
  descricao      String?
  criadoPorId    String?
  createdAt      DateTime      @default(now())

  movimentos Movimento[]

  @@map("transferencias")
}

model ExtratoImportacao {
  id              String        @id @default(cuid())
  contaBancariaId String
  contaBancaria   ContaBancaria @relation(fields: [contaBancariaId], references: [id])
  arquivoNome     String
  dataInicio      DateTime?     @db.Date
  dataFim         DateTime?     @db.Date
  saldoFinal      Decimal?      @db.Decimal(14, 2)
  dataSaldo       DateTime?     @db.Date
  totalItens      Int           @default(0)
  novosItens      Int           @default(0)
  criadoPorId     String?
  createdAt       DateTime      @default(now())

  itens ExtratoItem[]

  @@map("extrato_importacoes")
}

model ExtratoItem {
  id              String            @id @default(cuid())
  importacaoId    String
  importacao      ExtratoImportacao @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  contaBancariaId String
  contaBancaria   ContaBancaria     @relation(fields: [contaBancariaId], references: [id])
  fitId           String
  data            DateTime          @db.Date
  valor           Decimal           @db.Decimal(14, 2)
  descricao       String
  documento       String?
  status          StatusExtratoItem @default(PENDENTE)
  movimentoId     String?           @unique
  movimento       Movimento?        @relation(fields: [movimentoId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())

  @@unique([contaBancariaId, fitId])
  @@index([contaBancariaId, status, data])
  @@map("extrato_itens")
}

model RegraConciliacao {
  id            String       @id @default(cuid())
  /// Empresa (matriz) dona do cadastro; as filiais usam os cadastros da matriz.
  empresaId     String
  empresa       Empresa      @relation(fields: [empresaId], references: [id])
  termo         String
  tipo          TipoTitulo?
  categoriaId   String
  categoria     Categoria    @relation(fields: [categoriaId], references: [id])
  pessoaId      String?
  pessoa        Pessoa?      @relation(fields: [pessoaId], references: [id])
  centroCustoId String?
  centroCusto   CentroCusto? @relation(fields: [centroCustoId], references: [id])
  ativo         Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([empresaId])
  @@map("regras_conciliacao")
}

model Anexo {
  id          String   @id @default(cuid())
  tituloId    String?
  titulo      Titulo?  @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  nome        String
  mimeType    String
  tamanho     Int
  storage     String   @default("db")
  caminho     String?
  dados       Bytes?
  criadoPorId String?
  createdAt   DateTime @default(now())

  @@index([tituloId])
  @@map("anexos")
}

// ───────────────────────── Vendas (Fase 2) ─────────────────────────

enum StatusProposta {
  RASCUNHO
  ENVIADA
  APROVADA
  RECUSADA
  CANCELADA
}

enum StatusPedido {
  ABERTO
  FATURADO
  CANCELADO
}

/// Numeração sequencial por estabelecimento (CNPJ) e tipo de documento ("proposta", "pedido").
model SequenciaDocumento {
  empresaId String
  tipo      String
  ultimo    Int    @default(0)

  @@id([empresaId, tipo])
  @@map("sequencias_documento")
}

/// Proposta comercial (orçamento). `empresaId` é o estabelecimento emissor (matriz ou filial); os cadastros
/// usados (cliente, produtos, condição e forma) são da matriz.
model Proposta {
  id                  String             @id @default(cuid())
  empresaId           String
  empresa             Empresa            @relation(fields: [empresaId], references: [id])
  numero              Int
  status              StatusProposta     @default(RASCUNHO)
  pessoaId            String
  pessoa              Pessoa             @relation(fields: [pessoaId], references: [id])
  vendedorId          String?
  vendedor            Usuario?           @relation("VendedorProposta", fields: [vendedorId], references: [id])
  emissao             DateTime           @db.Date
  validade            DateTime           @db.Date
  condicaoPagamentoId String?
  condicaoPagamento   CondicaoPagamento? @relation(fields: [condicaoPagamentoId], references: [id])
  formaPagamentoId    String?
  formaPagamento      FormaPagamento?    @relation(fields: [formaPagamentoId], references: [id])
  /// texto para o cliente (sai no PDF)
  observacoes         String?
  /// anotações internas (não saem no PDF)
  observacoesInternas String?
  subtotal            Decimal            @default(0) @db.Decimal(14, 2)
  desconto            Decimal            @default(0) @db.Decimal(14, 2)
  total               Decimal            @default(0) @db.Decimal(14, 2)
  motivoRecusa        String?
  enviadaEm           DateTime?
  aprovadaEm          DateTime?
  recusadaEm          DateTime?
  canceladaEm         DateTime?
  /// oportunidade do CRM de onde a proposta saiu (aprovar a proposta marca a oportunidade como ganha)
  oportunidadeId      String?
  oportunidade        Oportunidade?      @relation(fields: [oportunidadeId], references: [id], onDelete: SetNull)
  criadoPorId         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  itens  PropostaItem[]
  pedido Pedido?

  @@unique([empresaId, numero])
  @@index([empresaId, status, emissao])
  @@index([pessoaId])
  @@index([oportunidadeId])
  @@map("propostas")
}

model PropostaItem {
  id                 String      @id @default(cuid())
  propostaId         String
  proposta           Proposta    @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  ordem              Int
  produtoId          String?
  produto            Produto?    @relation(fields: [produtoId], references: [id])
  tipo               TipoProduto
  descricao          String
  unidade            String
  quantidade         Decimal     @db.Decimal(14, 3)
  precoUnitario      Decimal     @db.Decimal(14, 4)
  descontoPercentual Decimal     @default(0) @db.Decimal(5, 2)
  total              Decimal     @db.Decimal(14, 2)

  @@index([propostaId, ordem])
  @@map("proposta_itens")
}

/// Pedido de venda. Pode nascer de uma proposta aprovada ou direto (venda de recicláveis, por exemplo).
/// Faturar gera as contas a receber (origem VENDA, origemId = id do pedido).
model Pedido {
  id                  String             @id @default(cuid())
  empresaId           String
  empresa             Empresa            @relation(fields: [empresaId], references: [id])
  numero              Int
  status              StatusPedido       @default(ABERTO)
  propostaId          String?            @unique
  proposta            Proposta?          @relation(fields: [propostaId], references: [id])
  pessoaId            String
  pessoa              Pessoa             @relation(fields: [pessoaId], references: [id])
  vendedorId          String?
  vendedor            Usuario?           @relation("VendedorPedido", fields: [vendedorId], references: [id])
  emissao             DateTime           @db.Date
  condicaoPagamentoId String?
  condicaoPagamento   CondicaoPagamento? @relation(fields: [condicaoPagamentoId], references: [id])
  formaPagamentoId    String?
  formaPagamento      FormaPagamento?    @relation(fields: [formaPagamentoId], references: [id])
  observacoes         String?
  observacoesInternas String?
  subtotal            Decimal            @default(0) @db.Decimal(14, 2)
  desconto            Decimal            @default(0) @db.Decimal(14, 2)
  total               Decimal            @default(0) @db.Decimal(14, 2)
  faturadoEm          DateTime?
  /// data escolhida no faturamento (emissão das contas a receber e da baixa no estoque)
  dataFaturamento     DateTime?          @db.Date
  canceladoEm         DateTime?
  motivoCancelamento  String?
  criadoPorId         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  itens             PedidoItem[]
  lancamentoEstoque LancamentoEstoque?
  notasFiscais      NotaFiscal[]
  notasServico      NotaServico[]

  faturamentoArmazem FaturamentoArmazem?

  @@unique([empresaId, numero])
  @@index([empresaId, status, emissao])
  @@index([empresaId, status, dataFaturamento])
  @@index([pessoaId])
  @@map("pedidos")
}

model PedidoItem {
  id                 String      @id @default(cuid())
  pedidoId           String
  pedido             Pedido      @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  ordem              Int
  produtoId          String?
  produto            Produto?    @relation(fields: [produtoId], references: [id])
  tipo               TipoProduto
  descricao          String
  unidade            String
  quantidade         Decimal     @db.Decimal(14, 3)
  precoUnitario      Decimal     @db.Decimal(14, 4)
  descontoPercentual Decimal     @default(0) @db.Decimal(5, 2)
  total              Decimal     @db.Decimal(14, 2)

  @@index([pedidoId, ordem])
  @@map("pedido_itens")
}

// ───────────────────────── CRM (Fase 2) ─────────────────────────

/// Etapas do funil. GANHA e PERDIDA fecham a oportunidade.
enum EtapaOportunidade {
  DESCOBERTA
  PROPOSTA
  NEGOCIACAO
  GANHA
  PERDIDA
}

enum TipoAtividade {
  LIGACAO
  WHATSAPP
  EMAIL
  REUNIAO
  VISITA
  TAREFA
}

/// Negócio em andamento com um cliente (ou lead). Pertence à empresa (matriz) ativa.
model Oportunidade {
  id                 String             @id @default(cuid())
  empresaId          String
  empresa            Empresa            @relation(fields: [empresaId], references: [id])
  titulo             String
  pessoaId           String
  pessoa             Pessoa             @relation(fields: [pessoaId], references: [id])
  /// com quem se fala no cliente (nome, cargo, telefone)
  contato            String?
  responsavelId      String?
  responsavel        Usuario?           @relation("ResponsavelOportunidade", fields: [responsavelId], references: [id], onDelete: SetNull)
  etapa              EtapaOportunidade  @default(DESCOBERTA)
  /// quando entrou na etapa atual (dias parados na etapa)
  etapaDesde         DateTime           @default(now())
  /// etapa em que estava ao ser ganha ou perdida (para reabrir no mesmo ponto)
  etapaAntesFechar   EtapaOportunidade?
  valor              Decimal            @default(0) @db.Decimal(14, 2)
  previsaoFechamento DateTime?          @db.Date
  /// código da origem do lead (lista fixa no módulo crm)
  origem             String?
  /// código do motivo de perda (lista fixa no módulo crm)
  motivoPerda        String?
  detalhePerda       String?
  observacoes        String?
  ganhaEm            DateTime?
  perdidaEm          DateTime?
  criadoPorId        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  atividades Atividade[]
  propostas  Proposta[]

  @@index([empresaId, etapa])
  @@index([pessoaId])
  @@index([responsavelId])
  @@map("oportunidades")
}

/// Ligação, reunião, tarefa etc. Pode estar ligada a uma oportunidade e/ou a um cliente.
model Atividade {
  id             String        @id @default(cuid())
  empresaId      String
  empresa        Empresa       @relation(fields: [empresaId], references: [id])
  tipo           TipoAtividade @default(TAREFA)
  assunto        String
  descricao      String?
  data           DateTime      @db.Date
  /// "HH:MM" opcional
  hora           String?
  responsavelId  String?
  responsavel    Usuario?      @relation("ResponsavelAtividade", fields: [responsavelId], references: [id], onDelete: SetNull)
  oportunidadeId String?
  oportunidade   Oportunidade? @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  pessoaId       String?
  pessoa         Pessoa?       @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  concluidaEm    DateTime?
  criadoPorId    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([empresaId, concluidaEm, data])
  @@index([responsavelId, concluidaEm, data])
  @@index([oportunidadeId])
  @@index([pessoaId])
  @@map("atividades")
}

/// Logotipo da empresa (matriz): sai no cabeçalho dos PDFs dela e das filiais.
/// Fica numa tabela à parte para as consultas de empresa não carregarem a imagem.
model LogoEmpresa {
  empresaId       String   @id
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// PNG ou JPEG já tratado no navegador (margens cortadas, até 1200 x 600 px)
  imagem          Bytes
  /// "png" ou "jpeg"
  formato         String
  largura         Int
  altura          Int
  atualizadoPorId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("logos_empresa")
}

// ───────────────────────── Estoque (Fase 3) ─────────────────────────

enum TipoLancamentoEstoque {
  /// entrada da produção ou triagem
  ENTRADA
  /// saída automática ao faturar o pedido de venda
  VENDA
  /// inventário ou correção (cada item pode entrar ou sair)
  AJUSTE
}

/// Lançamento de estoque num estabelecimento (matriz ou filial), com um item por material.
model LancamentoEstoque {
  id          String                @id @default(cuid())
  empresaId   String
  empresa     Empresa               @relation(fields: [empresaId], references: [id])
  /// numeração própria por estabelecimento
  numero      Int
  tipo        TipoLancamentoEstoque
  data        DateTime              @db.Date
  /// venda: pedido faturado que gerou a saída (desfazer o faturamento exclui o lançamento)
  pedidoId    String?               @unique
  pedido      Pedido?               @relation(fields: [pedidoId], references: [id])
  /// entrada: cliente de onde veio o material (rastreabilidade)
  pessoaId    String?
  pessoa      Pessoa?               @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  /// processo de destruição, MTR, lote ou ticket de pesagem
  /// nota fiscal recebida que originou a entrada (compra)
  documentoId String?               @unique
  documento   DocumentoRecebido?    @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  referencia  String?
  /// ajuste: código do motivo (lista fixa no módulo estoque)
  motivo      String?
  observacao  String?
  criadoPorId String?
  createdAt   DateTime              @default(now())

  itens ItemEstoque[]

  @@unique([empresaId, numero])
  @@index([empresaId, tipo, data])
  @@map("lancamentos_estoque")
}

model ItemEstoque {
  id            String            @id @default(cuid())
  lancamentoId  String
  lancamento    LancamentoEstoque @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto           @relation(fields: [produtoId], references: [id])
  /// positivo entra, negativo sai (na unidade do produto)
  quantidade    Decimal           @db.Decimal(14, 3)
  /// ajuste: saldo contado no inventário
  /// custo unitário da entrada (nota fiscal de compra)
  custoUnitario Decimal?          @db.Decimal(14, 4)
  saldoContado  Decimal?          @db.Decimal(14, 3)

  @@index([lancamentoId])
  @@index([produtoId])
  @@map("itens_estoque")
}

/// Saldo atual de cada material por estabelecimento. Sempre igual à soma dos itens; nunca negativo.
model SaldoEstoque {
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  produtoId  String
  produto    Produto  @relation(fields: [produtoId], references: [id])
  /// custo médio ponderado (entradas por nota fiscal)
  custoMedio Decimal  @default(0) @db.Decimal(14, 4)
  quantidade Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt  DateTime @updatedAt

  @@id([empresaId, produtoId])
  @@index([produtoId])
  @@map("saldos_estoque")
}

/// Certificado digital A1 do estabelecimento (CNPJ), para emitir NF-e e NFS-e (Fase 4).
/// Arquivo e senha ficam cifrados (AES-256-GCM, chave CERTIFICADOS_CHAVE do servidor, com o id da empresa
/// autenticado junto) e nunca saem do servidor. A filial sem certificado próprio usa o da matriz.
model CertificadoDigital {
  empresaId        String   @id
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  arquivoCifrado   Bytes
  senhaCifrada     Bytes
  /// nome do titular (CN sem o CNPJ)
  titular          String
  /// CNPJ do certificado (14 dígitos)
  cnpj             String?
  /// autoridade certificadora emissora
  emissor          String?
  numeroSerie      String
  /// SHA-256 do certificado (hex)
  impressaoDigital String
  validoDe         DateTime
  validoAte        DateTime
  enviadoPorId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([validoAte])
  @@map("certificados_digitais")
}

// ───────────────────────── Fiscal: notas recebidas (Fase 4, etapa 1) ─────────────────────────
// Captação das notas emitidas contra o CNPJ (NF-e e CT-e pelo DistDFe da SEFAZ, NFS-e pelo Ambiente Nacional).
// Dois motores com a mesma interface: SEFAZ direto (padrão, sem custo) e Focus NFe (reserva, desligado).

enum MotorFiscal {
  SEFAZ
  FOCUS
}

enum TipoDocumentoFiscal {
  NFE
  CTE
  NFSE
}

/// Papel do estabelecimento no documento.
enum DirecaoDocumento {
  /// destinatário da NF-e, tomador do CT-e ou da NFS-e
  ENTRADA
  /// emitente ou prestador
  SAIDA
  /// transportador, remetente, autorizado no XML etc.
  TERCEIRO
}

enum SituacaoDocumento {
  AUTORIZADO
  CANCELADO
  DENEGADO
}

/// Manifestação do destinatário da NF-e.
enum Manifestacao {
  CIENCIA
  CONFIRMACAO
  DESCONHECIMENTO
  NAO_REALIZADA
}

/// Configuração fiscal por estabelecimento (um CNPJ). A captação nasce desligada: dois sistemas consultando a
/// SEFAZ para o mesmo CNPJ levam a bloqueio por consumo indevido (cStat 656).
model ConfiguracaoFiscal {
  empresaId                String      @id
  empresa                  Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  captacaoAtiva            Boolean     @default(false)
  motor                    MotorFiscal @default(SEFAZ)
  /// 1 = produção, 2 = homologação
  ambiente                 Int         @default(1)
  captarNfe                Boolean     @default(true)
  captarCte                Boolean     @default(true)
  captarNfse               Boolean     @default(true)
  cienciaAutomatica        Boolean     @default(true)
  /// trava de captura: uma execução por CNPJ (dono e validade)
  travaToken               String?
  travaAte                 DateTime?
  /// Focus NFe (motor reserva): id da empresa lá e tokens cifrados (AES-256-GCM)
  focusEmpresaId           String?
  focusTokenProducao       Bytes?
  focusTokenHomologacao    Bytes?
  focusAtivadaEm           DateTime?
  /// Emissão de NF-e (modelo 55): ambiente nasce em homologação (2) até o administrador trocar
  nfeAtiva                 Boolean     @default(false)
  nfeAmbiente              Int         @default(2)
  nfeMotor                 MotorFiscal @default(SEFAZ)
  /// grupo IBS/CBS (LC 214/2025, NT 2025.002): NAO = não informar; HOMOLOGACAO = só em notas de homologação; SEMPRE = em toda nota
  nfeIbsCbs                String      @default("NAO")
  nfeSerie                 Int         @default(1)
  nfeProximoNumero         Int         @default(1)
  /// texto padrão das informações complementares (o do Simples Nacional vem preenchido)
  nfeInformacoes           String?
  /// Emissão de NFS-e pelo emissor nacional: ambiente 2 = produção restrita (testes), 1 = produção
  nfseAtiva                Boolean     @default(false)
  nfseAmbiente             Int         @default(2)
  nfseMotor                MotorFiscal @default(SEFAZ)
  nfseSerie                Int         @default(1)
  nfseProximoNumero        Int         @default(1)
  /// alíquota efetiva do Simples Nacional (pTotTribSN), em %, informada pelo contador
  nfseAliquotaSimples      Decimal     @default(6) @db.Decimal(5, 2)
  /// enviar a inscrição municipal na DPS (só quando o município cadastrou o contribuinte no CNC)
  nfseEnviarIM             Boolean     @default(false)
  nfseInformacoes          String?
  /// última conferência da adesão do município ao Emissor Nacional (ADN)
  nfseMunicipioAderente    Boolean?
  nfseMunicipioConferidoEm DateTime?
  atualizadoPorId          String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  @@map("configuracoes_fiscais")
}

/// Onde parou a captação de cada tipo, por estabelecimento e motor (NSU na SEFAZ, versão na Focus).
model CursorCaptura {
  id               String              @id @default(cuid())
  empresaId        String
  empresa          Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo             TipoDocumentoFiscal
  motor            MotorFiscal
  ultimoNsu        String              @default("0")
  maxNsu           String?
  consultadoEm     DateTime?
  /// cStat da última consulta real (137, 138, 656...) ou ERR
  status           String?
  mensagem         String?
  /// regra da SEFAZ: depois de "nenhum documento" (137) ou "consumo indevido" (656), só consultar de novo depois disto
  proximaConsulta  DateTime?
  /// a última execução parou antes do fim (teto de páginas ou de tempo)
  pendente         Boolean             @default(false)
  documentosUltima Int                 @default(0)
  updatedAt        DateTime            @updatedAt

  @@unique([empresaId, tipo, motor])
  @@map("cursores_captura")
}

model DocumentoRecebido {
  id                    String              @id @default(cuid())
  /// estabelecimento (CNPJ) contra o qual o documento foi emitido
  empresaId             String
  empresa               Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo                  TipoDocumentoFiscal
  /// chave de acesso (44 dígitos; NFS-e nacional tem 50)
  chave                 String
  direcao               DirecaoDocumento    @default(ENTRADA)
  numero                String?
  serie                 String?
  emitenteDocumento     String?
  emitenteNome          String?
  emitenteIe            String?
  destinatarioDocumento String?
  valor                 Decimal?            @db.Decimal(14, 2)
  emitidoEm             DateTime?
  situacao              SituacaoDocumento   @default(AUTORIZADO)
  protocolo             String?
  /// true quando o XML guardado é o documento completo; false = só o resumo (NF-e antes da manifestação)
  completo              Boolean             @default(false)
  xml                   String
  nsu                   String?
  motor                 MotorFiscal
  manifestacao          Manifestacao?
  manifestadoEm         DateTime?
  manifestacaoProtocolo String?
  manifestacaoErro      String?
  /// fornecedor vinculado (cadastro da matriz)
  pessoaId              String?
  pessoa                Pessoa?             @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  /// lançado no contas a pagar (títulos com origem NOTA_FISCAL e origemId = este id)
  lancadoEm             DateTime?
  lancadoPorId          String?
  /// NF-e de remessa para armazenagem (CFOP 5.905/6.905 ou remessa simbólica 5.934/6.934): mercadoria do depositante, não é compra
  armazenagem           Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  eventos           EventoDocumento[]
  lancamentoEstoque LancamentoEstoque?

  documentosArmazem DocumentoArmazem[]

  @@unique([empresaId, chave])
  @@index([empresaId, tipo, emitidoEm])
  @@index([empresaId, manifestacao])
  @@map("documentos_recebidos")
}

/// Eventos dos documentos recebidos (cancelamento, carta de correção, manifestações). Pode chegar antes do documento.
model EventoDocumento {
  id             String             @id @default(cuid())
  empresaId      String
  documentoId    String?
  documento      DocumentoRecebido? @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  chaveDocumento String
  /// código do evento (110111 cancelamento, 110110 carta de correção, 210210 ciência...)
  tipoEvento     String
  sequencia      Int                @default(1)
  descricao      String?
  /// texto da correção ou justificativa
  detalhe        String?
  ocorridoEm     DateTime?
  protocolo      String?
  xml            String
  nsu            String?
  createdAt      DateTime           @default(now())

  @@unique([empresaId, chaveDocumento, tipoEvento, sequencia])
  @@index([documentoId])
  @@map("eventos_documentos")
}

// ───────────────────────── Fiscal: emissão de NF-e (Fase 4, etapa 2) ─────────────────────────

enum StatusNotaFiscal {
  /// enviada, sem resposta definitiva (consultar)
  PROCESSANDO
  AUTORIZADA
  /// recusada pela SEFAZ: o número continua reservado para o reenvio corrigido (ou é inutilizado)
  REJEITADA
  DENEGADA
  CANCELADA
}

/// NF-e emitida pelo estabelecimento. O XML assinado e o autorizado (nfeProc) ficam guardados.
model NotaFiscal {
  id                        String           @id @default(cuid())
  empresaId                 String
  empresa                   Empresa          @relation(fields: [empresaId], references: [id])
  pedidoId                  String?
  pedido                    Pedido?          @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  modelo                    Int              @default(55)
  serie                     Int
  numero                    Int
  /// 1 produção, 2 homologação
  ambiente                  Int
  motor                     MotorFiscal
  /// 1 normal, 6 contingência SVC-AN
  tpEmis                    Int              @default(1)
  chave                     String?
  status                    StatusNotaFiscal @default(PROCESSANDO)
  cStat                     String?
  xMotivo                   String?
  protocolo                 String?
  emitidaEm                 DateTime
  autorizadaEm              DateTime?
  naturezaOperacao          String
  destinatarioNome          String
  destinatarioDocumento     String?
  valor                     Decimal          @db.Decimal(14, 2)
  /// XML assinado enviado (NFe) e XML autorizado (nfeProc)
  xml                       String?
  xmlAutorizado             String?
  contingenciaMotivo        String?
  canceladaEm               DateTime?
  cancelamentoProtocolo     String?
  cancelamentoJustificativa String?
  /// referência da nota na Focus NFe (motor reserva)
  focusRef                  String?
  emitidaPorId              String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  eventos EventoNotaFiscal[]

  @@unique([empresaId, modelo, serie, numero, ambiente])
  @@index([pedidoId])
  @@index([empresaId, emitidaEm])
  @@index([empresaId, status])
  @@map("notas_fiscais")
}

/// Eventos da NF-e emitida (cancelamento 110111, carta de correção 110110).
model EventoNotaFiscal {
  id           String     @id @default(cuid())
  notaId       String
  nota         NotaFiscal @relation(fields: [notaId], references: [id], onDelete: Cascade)
  tipoEvento   String
  sequencia    Int
  detalhe      String
  ok           Boolean
  cStat        String?
  xMotivo      String?
  protocolo    String?
  registradoEm DateTime?
  /// procEventoNFe (evento + retorno), quando registrado
  xml          String?
  usuarioId    String?
  createdAt    DateTime   @default(now())

  @@index([notaId])
  @@map("eventos_notas_fiscais")
}

/// Faixas de numeração inutilizadas na SEFAZ (números que não serão usados).
model InutilizacaoNfe {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  ambiente      Int
  serie         Int
  numeroInicial Int
  numeroFinal   Int
  justificativa String
  ok            Boolean
  cStat         String?
  xMotivo       String?
  protocolo     String?
  xml           String?
  usuarioId     String?
  createdAt     DateTime @default(now())

  @@index([empresaId, serie])
  @@map("inutilizacoes_nfe")
}

/// NFS-e emitida pelo emissor nacional (DPS → NFS-e). Uma nota por grupo de serviços do pedido com o mesmo código de tributação.
model NotaServico {
  id                       String           @id @default(cuid())
  empresaId                String
  empresa                  Empresa          @relation(fields: [empresaId], references: [id])
  pedidoId                 String?
  pedido                   Pedido?          @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  /// 1 = produção, 2 = produção restrita
  ambiente                 Int
  motor                    MotorFiscal
  serie                    Int
  /// nDPS (número da declaração; a NFS-e recebe outro número, dado pelo emissor nacional)
  numero                   Int
  idDps                    String?
  chave                    String?
  numeroNfse               String?
  status                   StatusNotaFiscal @default(PROCESSANDO)
  /// código do erro (E0039...) ou cStat da NFS-e
  codigo                   String?
  mensagem                 String?
  competencia              DateTime
  emitidaEm                DateTime
  autorizadaEm             DateTime?
  tomadorNome              String
  tomadorDocumento         String?
  codigoTributacaoNacional String
  descricao                String
  valor                    Decimal          @db.Decimal(14, 2)
  /// DPS assinada (enviada) e NFS-e devolvida pelo emissor nacional
  xml                      String?
  xmlAutorizado            String?
  canceladaEm              DateTime?
  cancelamentoCodigo       String?
  cancelamentoMotivo       String?
  cancelamentoXml          String?
  focusRef                 String?
  emitidaPorId             String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@unique([empresaId, serie, numero, ambiente])
  @@index([pedidoId])
  @@index([empresaId, emitidaEm])
  @@index([empresaId, status])
  @@map("notas_servico")
}

enum StatusEmail {
  PENDENTE
  ENVIADO
  FALHOU
}

/// Fila de e-mails transacionais (envio imediato com reenvio pelo cron). Anexos pequenos (PDF, XML) guardados em JSON base64.
model Email {
  id               String      @id @default(cuid())
  empresaId        String?
  tipo             String
  origemId         String?
  para             String
  copia            String?
  responderPara    String?
  assunto          String
  html             String
  texto            String
  /// [{ nome, tipo, base64 }]
  anexos           Json?
  status           StatusEmail @default(PENDENTE)
  tentativas       Int         @default(0)
  erro             String?
  provedorId       String?
  enviadoEm        DateTime?
  proximaTentativa DateTime?
  usuarioId        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status, proximaTentativa])
  @@index([empresaId, createdAt])
  @@index([tipo, origemId])
  @@map("emails")
}

/// Token de redefinição de senha ("esqueci minha senha"): só o hash fica guardado; vale 1 hora e uma vez.
model TokenSenha {
  id        String    @id @default(cuid())
  usuarioId String
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  @@index([usuarioId])
  @@map("tokens_senha")
}

enum TipoCobranca {
  BOLETO
  PIX
  UNDEFINED
}

/// Cobrança pelo Asaas, por estabelecimento (uma conta Asaas por CNPJ). A chave da API fica cifrada (AES-256-GCM).
model ConfiguracaoCobranca {
  empresaId             String       @id
  empresa               Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ativa                 Boolean      @default(false)
  /// 1 = produção (api.asaas.com), 2 = sandbox (api-sandbox.asaas.com)
  ambiente              Int          @default(2)
  chaveCifrada          Bytes?
  chaveFinal            String?
  /// conta onde o dinheiro recebido pelo Asaas é lançado na baixa
  contaBancariaId       String?
  formaPadrao           TipoCobranca @default(UNDEFINED)
  multaPercentual       Decimal      @default(2) @db.Decimal(5, 2)
  jurosMensal           Decimal      @default(1) @db.Decimal(5, 2)
  /// o Asaas também notifica o cliente (custa por cobrança); por padrão o ERP manda o próprio e-mail
  notificarPeloAsaas    Boolean      @default(false)
  enviarEmailAutomatico Boolean      @default(true)
  webhookToken          String?
  webhookId             String?
  webhookRegistradoEm   DateTime?
  testadaEm             DateTime?
  atualizadoPorId       String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@map("configuracoes_cobranca")
}

/// Cliente da empresa no Asaas (id do customer por conta Asaas).
model ClienteAsaas {
  id         String   @id @default(cuid())
  empresaId  String
  pessoaId   String
  customerId String
  createdAt  DateTime @default(now())

  @@unique([empresaId, pessoaId])
  @@map("clientes_asaas")
}

/// Cobrança (boleto/Pix) de um título a receber.
model Cobranca {
  id              String       @id @default(cuid())
  empresaId       String
  empresa         Empresa      @relation(fields: [empresaId], references: [id])
  tituloId        String
  titulo          Titulo       @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  pessoaId        String?
  asaasPaymentId  String       @unique
  asaasCustomerId String
  tipo            TipoCobranca
  /// status do Asaas: PENDING, RECEIVED, CONFIRMED, OVERDUE, REFUNDED, RECEIVED_IN_CASH, DELETED...
  status          String
  valor           Decimal      @db.Decimal(14, 2)
  valorLiquido    Decimal?     @db.Decimal(14, 2)
  vencimento      DateTime     @db.Date
  urlFatura       String?
  urlBoleto       String?
  linhaDigitavel  String?
  codigoBarras    String?
  nossoNumero     String?
  pixPayload      String?
  pixExpiraEm     DateTime?
  pagoEm          DateTime?
  baixaId         String?
  canceladaEm     DateTime?
  erro            String?
  criadaPorId     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  eventos EventoCobranca[]

  @@index([tituloId])
  @@index([empresaId, status])
  @@map("cobrancas")
}

/// Eventos recebidos do webhook do Asaas (id único = idempotência).
model EventoCobranca {
  id           String    @id @default(cuid())
  asaasEventId String    @unique
  cobrancaId   String?
  cobranca     Cobranca? @relation(fields: [cobrancaId], references: [id], onDelete: SetNull)
  empresaId    String?
  evento       String
  paymentId    String?
  payload      Json
  recebidoEm   DateTime  @default(now())
  processadoEm DateTime?
  erro         String?

  @@index([paymentId])
  @@map("eventos_cobranca")
}

enum Periodicidade {
  MENSAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

/// Contrato recorrente (plano, mensalidade): gera pedido faturado + conta a receber a cada competência, com cobrança opcional.
model Contrato {
  id                 String        @id @default(cuid())
  empresaId          String
  empresa            Empresa       @relation(fields: [empresaId], references: [id])
  numero             Int
  pessoaId           String
  pessoa             Pessoa        @relation(fields: [pessoaId], references: [id])
  produtoId          String?
  produto            Produto?      @relation(fields: [produtoId], references: [id])
  descricao          String
  valor              Decimal       @db.Decimal(14, 2)
  periodicidade      Periodicidade @default(MENSAL)
  /// dia do vencimento no mês da competência (1 a 28)
  diaVencimento      Int           @default(10)
  inicio             DateTime      @db.Date
  fim                DateTime?     @db.Date
  /// primeiro dia da próxima competência a gerar
  proximaCompetencia DateTime      @db.Date
  /// gerar com esta antecedência (dias antes do vencimento)
  antecedenciaDias   Int           @default(10)
  categoriaId        String?
  contaBancariaId    String?
  formaPagamentoId   String?
  gerarCobranca      Boolean       @default(false)
  observacoes        String?
  ativo              Boolean       @default(true)
  criadoPorId        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  geracoes ContratoGeracao[]

  @@unique([empresaId, numero])
  @@index([empresaId, ativo, proximaCompetencia])
  @@map("contratos")
}

model ContratoGeracao {
  id          String   @id @default(cuid())
  contratoId  String
  contrato    Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  competencia DateTime @db.Date
  pedidoId    String?
  tituloId    String?
  cobrancaId  String?
  erro        String?
  createdAt   DateTime @default(now())

  @@unique([contratoId, competencia])
  @@map("contratos_geracoes")
}

enum StatusOs {
  ABERTA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

/// Ordem de serviço: trabalho a executar para um cliente; ao concluir vira pedido (que fatura e emite a NFS-e).
model OrdemServico {
  id            String    @id @default(cuid())
  empresaId     String
  empresa       Empresa   @relation(fields: [empresaId], references: [id])
  numero        Int
  pessoaId      String
  pessoa        Pessoa    @relation(fields: [pessoaId], references: [id])
  produtoId     String?
  produto       Produto?  @relation(fields: [produtoId], references: [id])
  descricao     String
  detalhes      String?
  status        StatusOs  @default(ABERTA)
  responsavelId String?
  abertura      DateTime  @db.Date
  previsao      DateTime? @db.Date
  conclusao     DateTime? @db.Date
  quantidade    Decimal   @default(1) @db.Decimal(14, 3)
  valorUnitario Decimal   @default(0) @db.Decimal(14, 4)
  pedidoId      String?   @unique
  observacoes   String?
  ativo         Boolean   @default(true)
  criadoPorId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId, status])
  @@map("ordens_servico")
}

/// Memória do "de-para": código do produto no fornecedor → produto do cadastro (entrada no estoque pela nota recebida).
model VinculoProdutoFornecedor {
  id                  String   @id @default(cuid())
  empresaId           String
  fornecedorDocumento String
  codigoFornecedor    String
  produtoId           String
  produto             Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([empresaId, fornecedorDocumento, codigoFornecedor])
  @@map("vinculos_produto_fornecedor")
}

// ───────────────────────── Armazém geral (mercadorias de terceiros) ─────────────────────────

enum StatusRecebimentoArmazem {
  CONFERENCIA
  CONCLUIDO
}

enum TipoVolumeArmazem {
  CAIXA
  PALLET
}

/// ABERTO: em montagem na conferência (conteúdo muda livremente). FECHADO: armazenado (mudança de conteúdo é ajuste, com motivo).
enum StatusVolumeArmazem {
  ABERTO
  FECHADO
  EXPEDIDO
}

/// Posição do armazém (rua, módulo, nível…) onde ficam caixas e pallets. Por estabelecimento.
model EnderecoArmazem {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  /// código impresso na posição (ex.: A-01-02); único no estabelecimento
  codigo        String
  /// rua, área ou zona (filtro e etiqueta)
  zona          String?
  tipo          String   @default("PORTA_PALLET")
  /// quantos volumes cabem (vazio = sem limite)
  capacidade    Int?
  /// posição reservada para um depositante: só volumes dele entram
  depositanteId String?
  depositante   Pessoa?  @relation(fields: [depositanteId], references: [id], onDelete: SetNull)
  observacao    String?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  volumes VolumeArmazem[]

  @@unique([empresaId, codigo])
  @@index([empresaId, zona])
  @@map("enderecos_armazem")
}

/// Produto do depositante, pelo código dele (vem da NF-e de remessa ou da conferência). Cadastro da matriz.
model ProdutoDepositante {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  depositanteId String
  depositante   Pessoa   @relation(fields: [depositanteId], references: [id])
  codigo        String
  descricao     String
  unidade       String   @default("UN")
  ncm           String?
  gtin          String?
  /// valor unitário declarado na última NF-e (seguro e nota de retorno)
  valorUnitario Decimal? @db.Decimal(14, 4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  itensEsperados ItemRecebimentoArmazem[]
  conteudos      ConteudoVolume[]

  @@unique([empresaId, depositanteId, codigo])
  @@map("produtos_depositante")
}

/// Entrada física de mercadorias de um depositante (por NF-e, CT-e ou sem documento), conferida em caixas e pallets.
model RecebimentoArmazem {
  id            String                   @id @default(cuid())
  /// estabelecimento que recebe (o armazém)
  empresaId     String
  empresa       Empresa                  @relation(fields: [empresaId], references: [id])
  numero        Int
  depositanteId String
  depositante   Pessoa                   @relation(fields: [depositanteId], references: [id])
  status        StatusRecebimentoArmazem @default(CONFERENCIA)
  chegadaEm     DateTime                 @db.Date
  observacao    String?
  concluidoEm   DateTime?
  criadoPorId   String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  documentos DocumentoArmazem[]
  itens      ItemRecebimentoArmazem[]
  volumes    VolumeArmazem[]
  conteudos  ConteudoVolume[]

  @@unique([empresaId, numero])
  @@index([empresaId, status])
  @@map("recebimentos_armazem")
}

/// NF-e (remessa para armazenagem) ou CT-e (transporte) de um recebimento.
model DocumentoArmazem {
  id                  String              @id @default(cuid())
  recebimentoId       String
  recebimento         RecebimentoArmazem  @relation(fields: [recebimentoId], references: [id], onDelete: Cascade)
  /// estabelecimento do recebimento: a mesma chave não entra duas vezes no mesmo armazém
  empresaId           String
  tipo                TipoDocumentoFiscal
  chave               String
  numero              String?
  serie               String?
  emitenteDocumento   String?
  emitenteNome        String?
  emitidoEm           DateTime?
  valor               Decimal?            @db.Decimal(14, 2)
  /// CT-e: chaves das NF-e transportadas, peso e quantidade de volumes declarados
  nfesReferenciadas   String[]            @default([])
  pesoKg              Decimal?            @db.Decimal(15, 3)
  volumesDeclarados   Int?
  /// nota capturada pela busca de notas (Notas recebidas), quando veio de lá
  documentoRecebidoId String?
  documentoRecebido   DocumentoRecebido?  @relation(fields: [documentoRecebidoId], references: [id], onDelete: SetNull)
  /// XML enviado pelo usuário (o da nota capturada fica em documentos_recebidos)
  xml                 String?
  createdAt           DateTime            @default(now())

  itens ItemRecebimentoArmazem[]

  @@unique([empresaId, chave])
  @@index([recebimentoId])
  @@map("documentos_armazem")
}

/// Item esperado de um recebimento (da NF-e; com lote quando a nota traz o rastro).
model ItemRecebimentoArmazem {
  id            String             @id @default(cuid())
  recebimentoId String
  recebimento   RecebimentoArmazem @relation(fields: [recebimentoId], references: [id], onDelete: Cascade)
  documentoId   String?
  documento     DocumentoArmazem?  @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  /// nº do item na NF-e (nItem), para a nota de retorno
  numeroItem    Int?
  produtoId     String
  produto       ProdutoDepositante @relation(fields: [produtoId], references: [id])
  lote          String             @default("")
  quantidade    Decimal            @db.Decimal(15, 3)
  valorUnitario Decimal?           @db.Decimal(14, 4)
  cfop          String?

  @@index([recebimentoId])
  @@map("itens_recebimento_armazem")
}

/// Caixa ou pallet numerado, com mercadorias de um só depositante.
model VolumeArmazem {
  id                    String              @id @default(cuid())
  empresaId             String
  empresa               Empresa             @relation(fields: [empresaId], references: [id])
  tipo                  TipoVolumeArmazem
  /// numeração própria por estabelecimento e tipo (CX-0001, PL-0001)
  numero                Int
  depositanteId         String
  depositante           Pessoa              @relation(fields: [depositanteId], references: [id])
  /// recebimento em que o volume foi montado (vazio quando nasceu de uma transferência com várias origens)
  recebimentoId         String?
  recebimento           RecebimentoArmazem? @relation(fields: [recebimentoId], references: [id], onDelete: SetNull)
  status                StatusVolumeArmazem @default(ABERTO)
  enderecoId            String?
  endereco              EnderecoArmazem?    @relation(fields: [enderecoId], references: [id], onDelete: SetNull)
  enderecadoEm          DateTime?
  /// número ou identificação que o depositante usa para a caixa
  referenciaDepositante String?
  observacao            String?
  expedidoEm            DateTime?
  documentoSaida        String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  conteudo   ConteudoVolume[]
  movimentos MovimentoArmazem[]

  @@unique([empresaId, tipo, numero])
  @@index([empresaId, status])
  @@index([enderecoId])
  @@index([depositanteId])
  @@map("volumes_armazem")
}

/// O que há dentro de um volume: produto do depositante, lote e quantidade, com o recebimento de origem.
model ConteudoVolume {
  id            String             @id @default(cuid())
  volumeId      String
  volume        VolumeArmazem      @relation(fields: [volumeId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       ProdutoDepositante @relation(fields: [produtoId], references: [id])
  lote          String             @default("")
  quantidade    Decimal            @db.Decimal(15, 3)
  recebimentoId String
  recebimento   RecebimentoArmazem @relation(fields: [recebimentoId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([volumeId, produtoId, lote, recebimentoId])
  @@index([produtoId, lote])
  @@index([recebimentoId])
  @@map("conteudos_volume")
}

/// Histórico de cada volume: conteúdo conferido ou ajustado, endereçamento, transferências e saída.
model MovimentoArmazem {
  id        String        @id @default(cuid())
  empresaId String
  volumeId  String
  volume    VolumeArmazem @relation(fields: [volumeId], references: [id], onDelete: Cascade)
  tipo      String
  resumo    String
  dados     Json?
  usuarioId String?
  createdAt DateTime      @default(now())

  @@index([volumeId, createdAt])
  @@map("movimentos_armazem")
}

// ───────────────────────── Armazém geral: cobrança por posição-pallet ─────────────────────────

/// Tarifa de armazenagem do depositante no estabelecimento: R$ por palete no período e como contar os paletes.
model TarifaArmazem {
  id                String   @id @default(cuid())
  /// estabelecimento que presta o serviço (emite o pedido e a nota)
  empresaId         String
  empresa           Empresa  @relation(fields: [empresaId], references: [id])
  depositanteId     String
  depositante       Pessoa   @relation(fields: [depositanteId], references: [id])
  /// R$ por palete (posição-pallet) no período
  valorPosicao      Decimal  @db.Decimal(14, 2)
  /// FIM_PERIODO: paletes no último dia do período (apuração do fim do mês). PRO_RATA: palete-dia ÷ dias do período. PICO: maior quantidade do período.
  metodo            String   @default("FIM_PERIODO")
  /// mínimo de posições cobradas no mês (posições contratadas)
  minimoPosicoes    Int?
  /// posições reservadas para o depositante contam mesmo vazias
  cobrarReservadas  Boolean  @default(false)
  /// DIAS30: períodos de 30 dias contados do início (cobrados vencidos, ao fim de cada período). MES: mês do calendário.
  periodo           String   @default("MES")
  /// início da cobrança: os períodos de 30 dias contam a partir dele (em geral, a primeira entrada); os dias antes não entram
  inicio            DateTime @db.Date
  /// serviço do cadastro (dá o código de tributação da NFS-e)
  produtoId         String?
  produto           Produto? @relation(fields: [produtoId], references: [id])
  descricao         String   @default("Armazenagem de mercadorias")
  /// prazo de pagamento: dias depois do fim do período
  prazoPagamento    Int      @default(10)
  categoriaId       String?
  contaBancariaId   String?
  formaPagamentoId  String?
  gerarCobranca     Boolean  @default(false)
  /// fatura sozinho no dia seguinte ao fim do período (rotina diária às 6h40) e avisa os administradores por e-mail
  faturarAutomatico Boolean  @default(true)
  observacoes       String?
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  faturamentos FaturamentoArmazem[]

  @@unique([empresaId, depositanteId])
  @@map("tarifas_armazem")
}

/// Faturamento mensal da armazenagem de um depositante: o cálculo usado (cópia da tarifa) e o pedido gerado.
model FaturamentoArmazem {
  id               String         @id @default(cuid())
  empresaId        String
  empresa          Empresa        @relation(fields: [empresaId], references: [id])
  depositanteId    String
  depositante      Pessoa         @relation(fields: [depositanteId], references: [id])
  tarifaId         String?
  tarifa           TarifaArmazem? @relation(fields: [tarifaId], references: [id], onDelete: SetNull)
  /// período cobrado (inclusive): 30 dias contados do início da tarifa, ou o mês do calendário
  periodoInicio    DateTime       @db.Date
  periodoFim       DateTime       @db.Date
  tipoPeriodo      String         @default("DIAS30")
  metodo           String
  valorPosicao     Decimal        @db.Decimal(14, 2)
  minimoPosicoes   Int?
  cobrarReservadas Boolean
  /// divisor do proporcional: dias do período (30, ou os dias do mês)
  diasPeriodo      Int
  diasVigencia     Int
  /// dias sem fotografia (repetiram o dia anterior)
  diasRepetidos    Int            @default(0)
  /// soma das posições de cada dia (com as reservadas, se cobradas)
  posicoesDia      Int
  /// parte da soma que veio de posições reservadas vazias
  reservadasDia    Int            @default(0)
  pico             Int
  posicoesCobradas Decimal        @db.Decimal(12, 4)
  /// paletes apurados no último dia do período
  apurado          Int            @default(0)
  valor            Decimal        @db.Decimal(14, 2)
  vencimento       DateTime       @db.Date
  pedidoId         String?        @unique
  pedido           Pedido?        @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  tituloId         String?
  cobrancaId       String?
  erro             String?
  criadoPorId      String?
  createdAt        DateTime       @default(now())

  @@unique([empresaId, depositanteId, periodoInicio])
  @@index([empresaId, periodoFim])
  @@map("faturamentos_armazem")
}

/// Fotografia dos paletes de cada depositante num dia (a última do dia vale). Base da apuração mensal da armazenagem.
model OcupacaoArmazem {
  id                 String   @id @default(cuid())
  /// estabelecimento
  empresaId          String
  depositanteId      String
  dia                DateTime @db.Date
  /// paletes do depositante: cada palete conferido (em posição ou não) + cada posição só com caixas dele (a doca não conta como posição)
  posicoes           Int
  /// posições reservadas para o depositante e vazias
  reservadasVazias   Int      @default(0)
  /// volumes com itens no armazém (não expedidos)
  volumes            Int      @default(0)
  /// caixas conferidas sem endereço ou na doca: não entram na cobrança
  volumesForaPosicao Int      @default(0)
  /// códigos dos endereços ocupados
  enderecos          String[] @default([])
  atualizadoEm       DateTime @updatedAt

  @@unique([empresaId, depositanteId, dia])
  @@index([empresaId, dia])
  @@map("ocupacoes_armazem")
}

/// Dia fotografado no estabelecimento. Dia sem fotografia repete o último fotografado.
model FotografiaArmazem {
  empresaId String
  dia       DateTime @db.Date
  feitaEm   DateTime @updatedAt

  @@id([empresaId, dia])
  @@map("fotografias_armazem")
}
