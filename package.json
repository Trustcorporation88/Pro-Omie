{
  "name": "pro-omie",
  "version": "0.1.0",
  "private": true,
  "description": "Pro Omie - ERP interno da Trustcorp",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/gerar-marca.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/gerar-marca.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "postinstall": "prisma generate",
    "marca:codificar": "node scripts/gerar-marca.mjs --codificar"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "@vercel/functions": "3.10.2",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "dotenv": "18.0.8",
    "jose": "6.2.13",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  }
}
